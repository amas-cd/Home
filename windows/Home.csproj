<Project Sdk="Microsoft.NET.Sdk">
  <!-- Home pour Windows : la même interface que app/main.swift (SwiftUI n'existe pas sur Windows), en C# avec Avalonia.
       Compile aussi sur Mac (dotnet build) pour vérifier l'interface ; ce qui est propre à Windows (registre, XInput, winmm)
       est gardé par OperatingSystem.IsWindows(). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Home</AssemblyName>
    <RootNamespace>Home</RootNamespace>
    <Version>0.0.0</Version>
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- Le setup publié est compilé d'avance : sans ça, les premières animations saccadent le temps que .NET compile le code -->
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.23" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
    <PackageReference Include="FluentIcons.Avalonia" Version="2.0.316.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- L'écriture de Home sur Windows : Mona Sans (GitHub, licence OFL, voir polices/LICENCE-OFL.txt), à la place de SF Pro
         qu'Apple ne laisse pas redistribuer. La version large et très grasse sert aux titres. -->
    <AvaloniaResource Include="polices\*.ttf" />
    <AvaloniaResource Include="SCARLETNX-REF" />
  </ItemGroup>
  <ItemGroup>
    <!-- Les sons de l'interface sont ceux de la version Mac : une seule copie dans le dépôt -->
    <Content Include="..\app\sons\*.wav" Link="sons\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
