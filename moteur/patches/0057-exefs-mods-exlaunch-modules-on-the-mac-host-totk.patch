+#!/usr/bin/env python3
+"""Applies ExeFS mods (Atmosphère layout or emulator layout) to an extracted ExeFS, before the rewrite: IPS / IPS32 patches named after a module's build ID, and added or
+replaced code modules (subsdk1 for Starlight / exlaunch based mods such as Super Mario Odyssey: Online).
+
+Usage: exefs_mod.py <ExeFS dir> <out dir> <mod dir> [<mod dir> ...]
+Writes <out dir> as a copy of the ExeFS with the mods applied (patched modules as uncompressed NSOs with their hash flags cleared, as for a modified main on the Switch), and
+<out dir>/exefs_mod.json: {"added": [modules the profile does not list yet], "place": {module: offset from main's base}}.
+
+Placement. Horizon loads the modules one after the other from main (main, subsdk0, subsdk1, ..., sdk), each at its image size (text, ro, data and bss) rounded to 4 KB, and a mod's
+IPS patches branch from main straight into the module it adds (a BL at a fixed distance), and the added module branches back into main the same way. The host maps every module on
+its own, at 16 KB pages, so it cannot keep Horizon's distance when that is not a multiple of 16 KB. So an added module gets a place: its offset from main's base, Horizon's distance
+rounded up to 16 KB; every B / BL in the IPS patches whose target falls inside the added module, and every B / BL of the added module whose target falls outside of it, is moved by
+the difference. The host (loader.c) maps the module at that offset from main (the PLACE_MAIN_OFF row the build adds to its fixups.tsv). The targets are checked: a branch out of
+main must land inside an added module, a branch out of an added module must land in main's text, else the mod was made for another build and this stops."""
+import json, os, shutil, struct, sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import nso
+
+PAGE, HOST_PAGE, NSO_HEADER = 0x1000, 0x4000, 0x100
+MODULE_NAMES = ['main'] + [f'subsdk{i}' for i in range(10)] + ['sdk']
+
+
+def align(v, a): return (v + a - 1) // a * a
+
+
+def mod_exefs_dirs(mod, title_id):
+    """The folders of one mod that hold ExeFS files: <mod>/exefs, Atmosphère's contents/<id>/exefs, Atmosphère's exefs_patches/<name>/ and the mod folder's own subfolders that have them"""
+    out = []
+    for c in [mod / 'exefs', mod / 'atmosphere/contents' / title_id / 'exefs', mod / 'contents' / title_id / 'exefs']:
+        if c.is_dir(): out.append(c)
+    for root in (mod / 'atmosphere/exefs_patches', mod / 'exefs_patches'):
+        if root.is_dir(): out += [p for p in sorted(root.iterdir()) if p.is_dir()]
+    if not out:   # a mod folder that wraps the mod once more (SMO_Online_v1/SMOO/exefs)
+        for sub in sorted(p for p in mod.iterdir() if p.is_dir()):
+            out += mod_exefs_dirs(sub, title_id)
+    return out
+
+
+def read_ips(path):
+    """[(image offset, bytes)] of an IPS or IPS32 file (offsets in the file count from the NSO header, which the image does not have)"""
+    d = path.read_bytes()
+    if d[:5] == b'PATCH': w, end = 3, b'EOF'; at = 5
+    elif d[:5] == b'IPS32': w, end = 4, b'EEOF'; at = 5
+    else: raise SystemExit(f'[RED] {path}: not an IPS / IPS32 patch')
+    recs = []
+    while d[at:at + len(end)] != end:
+        if at + w + 2 > len(d): raise SystemExit(f'[RED] {path}: cut short')
+        off = int.from_bytes(d[at:at + w], 'big'); n = int.from_bytes(d[at + w:at + w + 2], 'big'); at += w + 2
+        if n: data = d[at:at + n]; at += n
+        else: rle = int.from_bytes(d[at:at + 2], 'big'); data = d[at + 2:at + 3] * rle; at += 3
+        if off < NSO_HEADER: raise SystemExit(f'[RED] {path}: a patch at {off:#x} writes the NSO header')
+        recs.append((off - NSO_HEADER, data))
+    return recs
+
+
+def branch_target(word, pc):
+    """Target of a B / BL at pc, None for any other instruction"""
+    if word & 0x7C000000 != 0x14000000: return None
+    imm = word & 0x3FFFFFF
+    if imm & 0x2000000: imm -= 0x4000000
+    return pc + imm * 4
+
+
+def with_target(word, pc, target):
+    d = (target - pc) // 4
+    if not -0x2000000 <= d < 0x2000000: raise SystemExit(f'[RED] a branch at {pc:#x} cannot reach {target:#x} after the move')
+    return (word & 0xFC000000) | (d & 0x3FFFFFF)
+
+
+def image_span(m):
+    """Horizon's size of a module: the end of its last segment plus bss, rounded to 4 KB"""
+    return align(max(o + s for o, s in m.segments) + m.bss, PAGE)
+
+
+def write_nso(path, src, m):
+    """An uncompressed NSO of module m: the original header (build ID, module name, dynamic info), each segment stored at its size, compression and hash flags cleared"""
+    h = bytearray(src[:NSO_HEADER])
+    struct.pack_into('<I', h, 0xc, 0)
+    at, body = NSO_HEADER, bytearray()
+    for i, (mo, sz) in enumerate(m.segments):
+        struct.pack_into('<III', h, 0x10 + i * 0x10, at, mo, sz)
+        struct.pack_into('<I', h, 0x60 + i * 4, sz)
+        body += m.image[mo:mo + sz]; at += sz
+    path.write_bytes(bytes(h) + bytes(body))
+
+
+def lock_sead_heaps(m, name):
+    """sead::ExpHeap::create(..., enableLock) calls of an added module with enableLock = false (mov w5, #0 before the BL to its PLT stub) get true. On the Switch a mod's threads
+    and the game's main thread share core 0, so they never run at once and a heap without a lock is safe there (Super Mario Odyssey: Online's ClientHeap, used by its socket threads
+    and by the main thread); the host runs every guest thread on a host thread of its own, at the same time, and such a heap corrupted its free list (a crash in
+    sead::ExpHeap::pushToFreeList_ from Client::sendGameInfPacket). Returns the number of calls changed"""
+    img = m.image
+    try:
+        mod0 = struct.unpack_from('<I', img, 4)[0]; dyn = mod0 + struct.unpack_from('<i', img, mod0 + 4)[0]
+        tags, i = {}, 0
+        while True:
+            t, v = struct.unpack_from('<qQ', img, dyn + i * 16); i += 1
+            if t == 0: break
+            tags.setdefault(t, v)
+        symtab, strtab, jmprel, pltsz = tags[6], tags[5], tags[23], tags[2]
+    except (KeyError, struct.error): return 0
+    def sym(si):
+        n = struct.unpack_from('<I', img, symtab + si * 24)[0]; return bytes(img[strtab + n:img.index(b'\0', strtab + n)]).decode('latin1')
+    slots = {off for off, info, _ in (struct.unpack_from('<QQq', img, jmprel + k * 24) for k in range(pltsz // 24)) if sym(info >> 32).startswith('_ZN4sead7ExpHeap6createE')}
+    if not slots: return 0
+    stubs = set()
+    for o in range(0, m.text_end - 4, 4):
+        w = struct.unpack_from('<I', img, o)[0]
+        if w & 0x9F00001F != 0x90000010: continue   # adrp x16
+        imm = (w >> 29 & 3) | ((w >> 5 & 0x7FFFF) << 2)
+        if imm & 0x100000: imm -= 0x200000
+        w2 = struct.unpack_from('<I', img, o + 4)[0]
+        if w2 & 0xFFC003FF == 0xF9400211 and (o & ~0xFFF) + (imm << 12) + (w2 >> 10 & 0xFFF) * 8 in slots: stubs.add(o)   # ldr x17, [x16, #slot]
+    n = 0
+    for o in range(0, m.text_end, 4):
+        t = branch_target(struct.unpack_from('<I', img, o)[0], o)
+        if t not in stubs or struct.unpack_from('<I', img, o)[0] & 0xFC000000 != 0x94000000: continue
+        for b in range(1, 10):   # the w5 set up for this call
+            w = struct.unpack_from('<I', img, o - 4 * b)[0]
+            if w & 0x1F != 5: continue
+            if w in (0x52800005, 0x2A1F03E5): struct.pack_into('<I', img, o - 4 * b, 0x52800025); n += 1   # mov w5, #0 / mov w5, wzr -> mov w5, #1
+            break
+    if n: print(f'{name}: {n} sead::ExpHeap::create calls made thread-safe (enableLock = true): the host runs its threads at the same time as the game\'s')
+    return n
+
+
+def main(argv):
+    if len(argv) < 4: raise SystemExit(__doc__)
+    exefs, out, mods = Path(argv[1]), Path(argv[2]), [Path(a) for a in argv[3:]]
+    if out.exists(): shutil.rmtree(out)
+    shutil.copytree(exefs, out, copy_function=shutil.copy2)
+    title_id = os.environ.get('DM_TITLE_ID', '')
+    if not title_id:
+        try: title_id = '%016X' % struct.unpack_from('<Q', (exefs / 'main.npdm').read_bytes(), 0x290)[0]   # ACI0 program ID; only used to find Atmosphère folders
+        except OSError: pass
+    present = {n: out / n for n in MODULE_NAMES if (out / n).is_file()}
+    loaded = {n: nso.read(p) for n, p in present.items()}
+    bid = {n: m.build_id[:0x10].hex().upper() for n, m in loaded.items()}
+    patches, added = {}, []
+    for mod in mods:
+        dirs = mod_exefs_dirs(mod, title_id)
+        if not dirs: print(f'{mod}: no ExeFS files (a RomFS only mod is mounted by the launcher, DM_ROMFS_OVERLAY)'); continue
+        for d in dirs:
+            for f in sorted(d.iterdir()):
+                if f.suffix.lower() == '.ips':
+                    key = f.stem.upper()[:32].rstrip('0')
+                    hit = [n for n, b in bid.items() if key and b.startswith(key)]
+                    if not hit: print(f'{f}: names no module of this build ({", ".join(f"{n} {b}" for n, b in bid.items())}), left out'); continue
+                    patches.setdefault(hit[0], []).append(f); print(f'{f.name}: patches {hit[0]}')
+                elif f.name in MODULE_NAMES and f.name not in ('main', 'sdk', 'rtld'):
+                    if f.name not in present: added.append(f.name)
+                    shutil.copyfile(f, out / f.name); present[f.name] = out / f.name; loaded[f.name] = nso.read(out / f.name)
+                    print(f'{f.name}: {"added" if f.name in added else "replaced"} from {f}')
+                elif f.name.endswith('.pchtxt'): print(f'{f}: .pchtxt patches are not read yet, left out')
+    if not patches and not added: print('no ExeFS change'); json.dump({'added': [], 'place': {}}, open(out / 'exefs_mod.json', 'w')); return
+    # Horizon's layout from main, and the host's (each added module at a 16 KB multiple)
+    order = sorted(loaded, key=lambda n: MODULE_NAMES.index(n))
+    hz, at = {}, 0
+    for n in order:
+        hz[n] = at; at += image_span(loaded[n])
+    place = {n: align(hz[n], HOST_PAGE) for n in added}
+    span = {n: (hz[n], hz[n] + image_span(loaded[n])) for n in added}
+    def moved(t):   # (new target, module) of a Horizon target from main's base that falls in an added module
+        for n, (a, b) in span.items():
+            if a <= t < b: return t - hz[n] + place[n], n
+        return None, None
+    linked = {n: 0 for n in added}   # fixed-distance links between an added module and main (IPS branches into it, its branches / ADRP pages out of it)
+    for n, files in patches.items():
+        m = loaded[n]; img = m.image; base = hz[n]; nb = 0
+        for f in files:
+            for off, data in read_ips(f):
+                if off + len(data) > len(img): raise SystemExit(f'[RED] {f}: writes {off:#x}..{off + len(data):#x}, past {n}\'s image ({len(img):#x})')
+                data = bytearray(data)
+                for k in range(0, len(data) - 3, 4):
+                    if (off + k) % 4: break
+                    w = struct.unpack_from('<I', data, k)[0]; t = branch_target(w, off + k)
+                    if t is None or 0 <= t < len(img): continue
+                    nt, into = moved(base + t)
+                    if into is None: raise SystemExit(f'[RED] {f}: a branch at {n}+{off + k:#x} goes to {n}+{t:#x}, into no module the mod adds: the patch is for another build or layout')
+                    struct.pack_into('<I', data, k, with_target(w, off + k, nt - base)); nb += 1; linked[into] += 1
+                img[off:off + len(data)] = data
+        write_nso(present[n], (exefs / n).read_bytes(), m)
+        print(f'{n}: {sum(len(read_ips(f)) for f in files)} patch records applied, {nb} branches into added modules moved to the host layout')
+    main_text = loaded['main'].text_end
+    for n in added:
+        m = loaded[n]; img = m.image; lo, hi = 0, image_span(m); nb = 0
+        for off in range(0, m.text_end, 4):
+            w = struct.unpack_from('<I', img, off)[0]; t = branch_target(w, off)
+            if t is None or lo <= t < hi: continue
+            to_main = hz[n] + t
+            if not 0 <= to_main < main_text: raise SystemExit(f'[RED] {n}: a branch at +{off:#x} goes to main+{to_main:#x}, outside main\'s text ({main_text:#x}): the mod is for another build')
+            struct.pack_into('<I', img, off, with_target(w, off, to_main - place[n])); nb += 1
+        linked[n] += nb
+        # ADRP to a page outside the module (a fixed distance to main's data or code): only Horizon's layout keeps it right
+        adrp_out = 0
+        for off in range(0, m.text_end, 4):
+            w = struct.unpack_from('<I', img, off)[0]
+            if (w & 0x9F000000) != 0x90000000: continue
+            imm = ((w >> 29) & 3) | (((w >> 5) & 0x7FFFF) << 2)
+            if imm & (1 << 20): imm -= 1 << 21
+            t = (off & ~0xFFF) + (imm << 12)
+            if not lo <= t < ((hi + 0xFFF) & ~0xFFF): adrp_out += 1
+        linked[n] += adrp_out
+        lock_sead_heaps(m, n)
+        write_nso(present[n], present[n].read_bytes(), m)
+        print(f'{n}: Horizon places it at main+{hz[n]:#x}, the host at main+{place[n]:#x}; {nb} branches into main moved, {adrp_out} ADRP pages outside it')
+    for n in added:
+        if not linked[n]:   # nothing ties it to main by distance (an exlaunch module finds main at run time): only nearness, for its B hooks (±128 MB)
+            place[n] = 1; print(f'{n}: no fixed-distance link to main: the host maps it right after main (place 1)')
+    json.dump({'added': added, 'place': {n: hex(v) for n, v in place.items()}}, open(out / 'exefs_mod.json', 'w'))
+
+
+if __name__ == '__main__':
+    main(sys.argv)
