diff --git a/dm/host/hle_svc.c b/dm/host/hle_svc.c
index e87442e..c7b9f30 100644
--- a/dm/host/hle_svc.c
+++ b/dm/host/hle_svc.c
@@ -801,6 +801,121 @@ static void *regions_thread(void *arg) {
 
 int svc_thread(int num, uint64_t *regs);   // hle_thread.c: thread and synchronization kind
 
+
+#include <TargetConditionals.h>
+// ---------- MapProcessMemory / UnmapProcessMemory (0x74 / 0x75) on the process's own code ----------
+// exlaunch based mods (Tears of the Kingdom Online's subsdk4) map an RW view of a module's code (svcMapProcessMemory at an address
+// virtmem picked at 4 KB granularity) and write their hooks through it. Apple's 16 KB pages cannot alias two ranges whose offsets
+// differ modulo 16 KB, so the view is a copy (as MapMemory does): the guest's writes into it are found by comparing with a snapshot
+// and carried into the code through a writable alias of the module (the pages the game executes; then the instruction cache is
+// invalidated). Synced after every module's DT_INIT, on unmap, and every 250 ms by a thread.
+#if !TARGET_OS_IPHONE
+#include <mach/mach_vm.h>
+#include <libkern/OSCacheControl.h>
+typedef struct { uint64_t rw, ro, size; uint8_t *snap; } pmirror_t;
+static pmirror_t g_pm[256]; static int g_npm;
+static pthread_mutex_t g_pm_mu = PTHREAD_MUTEX_INITIALIZER;
+static struct { uint8_t *base, *alias; size_t size; } g_pal[16]; static int g_npal;
+static uint8_t *pm_alias(uint8_t *a) {   // caller holds g_pm_mu
+    module_t *m = module_of(a); if (!m) return NULL;
+    for (int i = 0; i < g_npal; i++) if (g_pal[i].base == m->base) return a >= g_pal[i].base && a < g_pal[i].base + g_pal[i].size ? g_pal[i].alias + (a - g_pal[i].base) : NULL;
+    if (g_npal == 16) return NULL;
+    long pg = sysconf(_SC_PAGESIZE); if (pg <= 0) pg = 0x4000;
+    uint64_t size = ((uint64_t)m->size + (uint64_t)pg - 1) & ~((uint64_t)pg - 1);
+    mach_vm_address_t dst = 0; vm_prot_t cur = 0, mx = 0;
+    if (mach_vm_remap(mach_task_self(), &dst, size, 0, VM_FLAGS_ANYWHERE, mach_task_self(), (mach_vm_address_t)(uintptr_t)m->base, FALSE, &cur, &mx, VM_INHERIT_SHARE)) return NULL;
+    if (mach_vm_protect(mach_task_self(), dst, size, 0, VM_PROT_READ | VM_PROT_WRITE)) { mach_vm_deallocate(mach_task_self(), dst, size); return NULL; }
+    g_pal[g_npal].base = m->base; g_pal[g_npal].alias = (uint8_t *)(uintptr_t)dst; g_pal[g_npal].size = size; g_npal++;
+    LOG("process memory: writable alias of %s for a mod's code writes", m->name);
+    return a < m->base + size ? (uint8_t *)(uintptr_t)dst + (a - m->base) : NULL;
+}
+static void pm_sync_one(pmirror_t *p, unsigned long *n, unsigned long *lost) {   // caller holds g_pm_mu
+    // Word by word (an aligned 32-bit store): an instruction is never seen half written. The first writes are logged as module+offset,
+    // to check them against the rewriter's changed words (main.changed.tsv) when a hook misbehaves
+    static int logged;
+    uint8_t *rw = (uint8_t *)(uintptr_t)p->rw, *ro = (uint8_t *)(uintptr_t)p->ro;
+    for (uint64_t blk = 0; blk < p->size; blk += 0x1000) {
+        uint64_t end = blk + 0x1000 < p->size ? blk + 0x1000 : p->size;
+        if (!memcmp(rw + blk, p->snap + blk, end - blk)) continue;
+        for (uint64_t o = blk & ~3ull; o + 4 <= end; o += 4) {
+            uint32_t now, was; memcpy(&now, rw + o, 4); memcpy(&was, p->snap + o, 4);
+            if (now == was) continue;
+            uint8_t *w = pm_alias(ro + o);
+            if (w && !((uintptr_t)w & 3)) {
+                __atomic_store_n((uint32_t *)w, now, __ATOMIC_RELEASE); sys_icache_invalidate(ro + o, 4); (*n) += 4;
+                if (logged < 64) { module_t *m = module_of(ro + o); logged++; LOG("process memory: mod write %s+%#llx: %08x -> %08x", m ? m->name : "?", (unsigned long long)(m ? (uint64_t)(ro + o - m->base) : (uint64_t)(uintptr_t)(ro + o)), was, now); }
+            } else (*lost) += 4;
+            memcpy(p->snap + o, &now, 4);
+        }
+    }
+}
+uint8_t *dm_code_alias(uint8_t *a) { pthread_mutex_lock(&g_pm_mu); uint8_t *w = pm_alias(a); pthread_mutex_unlock(&g_pm_mu); return w; }   // loader.c setup_autoload_list
+void dm_pmirror_sync(void) {
+    unsigned long n = 0, lost = 0; static unsigned long total;
+    pthread_mutex_lock(&g_pm_mu);
+    for (int i = 0; i < g_npm; i++) pm_sync_one(&g_pm[i], &n, &lost);
+    pthread_mutex_unlock(&g_pm_mu);
+    if (n || lost) { total += n; LOG("process memory: %lu byte(s) of a mod's code writes carried into the code (%lu in all)%s", n, total, lost ? ", some outside any module were dropped" : ""); }
+}
+// The hooks come in the mod's DT_INIT (synced right after it); later writes (its Python plugins' code patcher) are rare: every 250 ms is enough and keeps the
+// comparison of the views (about 90 MB, all of main, sdk, subsdk0 and the mod) off the game's cores
+static void *pm_thread(void *arg) { (void)arg; for (;;) { usleep(250000); dm_pmirror_sync(); } return NULL; }
+#else
+void dm_pmirror_sync(void) {}
+uint8_t *dm_code_alias(uint8_t *a) { (void)a; return NULL; }
+#endif
+
+// A stand-in rtld for exlaunch mods that find the loaded modules by walking the address space: UltraCam's InitMemLayout queries from address 0 and takes each
+// Code RX, Code R, CodeData RW run for a module, the first for rtld and the second for main, as on Horizon where rtld is loaded below main. The host loads no rtld:
+// UltraCam took main for rtld and itself (the module after main) for main, added a game offset to its own base and aborted on a null vtable entry
+// (exl::hook::nx64::Hook "hook != 0", subsdk3+0x794e8). With an ExeFS mod loaded (PLACE_MAIN_OFF), QueryMemory reports below the lowest module three 4 KB regions,
+// Code RX, Code R, CodeData RW, on a zeroed page of their own. Mods that read the module list instead (Tears of the Kingdom Online, g_pAutoLoadList) see no change. DM_FAKE_RTLD=0 turns it off
+static uint64_t fake_rtld_base(void) {
+    static int done; static uint64_t fr;
+    if (done) return fr;
+    done = 1;
+    const char *e = getenv("DM_FAKE_RTLD"); if (e && !strcmp(e, "0")) return 0;
+    uint64_t lo = 0; int mods = 0;
+    for (int i = 0; i < g_nmod; i++) {
+        if (!g_mod[i].base || g_mod[i].nro) continue;
+        if (g_mod[i].place_main_off) mods++;
+        uint64_t b = (uint64_t)(uintptr_t)g_mod[i].base + (g_mod[i].patch_off < 0 ? (uint64_t)g_mod[i].patch_off : 0);
+        if (!lo || b < lo) lo = b;
+    }
+    if (!mods || lo < 0x1000000) return 0;
+    // UltraCam also scans each module's code for byte patterns, so the page is real (zeroes). A hint below the lowest module found no room (the 16 MB below main are taken,
+    // and a hint that is taken makes the kernel look upward): on macOS the highest free page below it is found from the task's region list and allocated there (VM_FLAGS_FIXED fails, never replaces)
+#if !TARGET_OS_IPHONE
+    {
+        mach_vm_address_t a = 0x100000000ull; uint64_t best = 0;
+        while (a < lo) {
+            mach_vm_address_t r = a; mach_vm_size_t rs = 0; vm_region_basic_info_data_64_t info; mach_msg_type_number_t cnt = VM_REGION_BASIC_INFO_COUNT_64; mach_port_t obj = MACH_PORT_NULL;
+            kern_return_t kr = mach_vm_region(mach_task_self(), &r, &rs, VM_REGION_BASIC_INFO_64, (vm_region_info_t)&info, &cnt, &obj);
+            uint64_t top = kr == KERN_SUCCESS && r < lo ? (uint64_t)r : lo;   // the free run [a, top) before the next region
+            if (top >= a + 0x4000) best = (top - 0x4000) & ~0x3FFFull;
+            if (kr != KERN_SUCCESS || r + rs >= lo || r + rs <= a) break;
+            a = r + rs;
+        }
+        vm_address_t va = (vm_address_t)best;
+        if (best && vm_allocate(mach_task_self(), &va, 0x4000, VM_FLAGS_FIXED) == KERN_SUCCESS) fr = (uint64_t)va;
+    }
+#endif
+    for (uint64_t d = 0x4000; d <= 0x1000000 && !fr; d += 0x4000) {
+        void *pg = mmap((void *)(uintptr_t)(lo - d), 0x4000, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0);
+        if (pg == MAP_FAILED) continue;
+        if ((uint64_t)(uintptr_t)pg + 0x4000 <= lo) fr = (uint64_t)(uintptr_t)pg; else munmap(pg, 0x4000);
+    }
+    if (fr) LOG("process memory: a stand-in rtld at %#llx below the lowest module, on a zeroed page of its own, for exlaunch mods that walk the address space (DM_FAKE_RTLD=0 turns it off)", (unsigned long long)fr);
+    else {
+        // No free page below it: the host's executable, dyld and the libraries fill the address space up to main (Tears of the Kingdom with UltraCam on a MacBook Air M5, no 16 KB hole
+        // from 0x100000000 to main). The stand-in is then only reported, on the 16 KB just below the lowest module: UltraCam reads module 0's addresses, never its bytes
+        // (its pattern scans read the sdk, the last module), and what is there is the host's own memory
+        fr = (lo - 0x4000) & ~0x3FFFull;
+        LOG("process memory: a stand-in rtld reported at %#llx, below the lowest module, with no page of its own (none free below it), for exlaunch mods that walk the address space (DM_FAKE_RTLD=0 turns it off)", (unsigned long long)fr);
+    }
+    return fr;
+}
+
 uint64_t svc_dispatch(int num, uint64_t *regs, uint64_t orig_addr) {
     { void hlecount_svc(int); hlecount_svc(num); }   // DM_HLECOUNT: svc counts by number
     mem_init();
@@ -847,6 +962,39 @@ uint64_t svc_dispatch(int num, uint64_t *regs, uint64_t orig_addr) {
         pthread_mutex_unlock(&g_map_lock);
         regs[0] = busy ? 0xD401 : 0; return 0;
     }
+#if !TARGET_OS_IPHONE
+    case 0x74: {  // MapProcessMemory(dst, process, src, size): an RW copy of the process's own code at dst (see the helpers above)
+        uint64_t dst = regs[0], src = regs[2], size = regs[3];
+        if (!size || ((dst | src | size) & 0xfff) || !dm_guest_as_contains((uintptr_t)dst) || !module_of((void *)(uintptr_t)src)) {
+            LOG("[RED] MapProcessMemory refused: %#llx <- %#llx +%#llx (only a module's own pages into the guest address space)", (unsigned long long)dst, (unsigned long long)src, (unsigned long long)size);
+            regs[0] = 0xD401; return 0; }
+        pthread_mutex_lock(&g_map_lock);
+        if (map_find(dst, size) || g_nmap == MAX_MAP) { pthread_mutex_unlock(&g_map_lock); regs[0] = 0xD401; return 0; }
+        uint64_t mask = (size_t)getpagesize() - 1, lo = dst & ~mask, hi = (dst + size + mask) & ~mask;
+        if (mprotect((void *)lo, hi - lo, PROT_READ | PROT_WRITE)) die("MapProcessMemory mprotect errno=%d", errno);
+        dm_guest_write_prepare((void *)lo, hi - lo);
+        memcpy((void *)dst, (void *)src, size);
+        map_add(dst, size, 0, 0x0B);
+        pthread_mutex_unlock(&g_map_lock);
+        pthread_mutex_lock(&g_pm_mu);
+        if (g_npm < 256) { uint8_t *snap = malloc(size); memcpy(snap, (void *)src, size); g_pm[g_npm++] = (pmirror_t){dst, src, size, snap}; }
+        static int started; if (!started) { started = 1; pthread_t t; pthread_create(&t, NULL, pm_thread, NULL); pthread_detach(t); }
+        pthread_mutex_unlock(&g_pm_mu);
+        LOG("MapProcessMemory %#llx <- %s+%#llx +%#llx", (unsigned long long)dst, module_of((void *)(uintptr_t)src)->name, (unsigned long long)(src - (uint64_t)module_of((void *)(uintptr_t)src)->base), (unsigned long long)size);
+        regs[0] = 0; return 0;
+    }
+    case 0x75: {  // UnmapProcessMemory(dst, process, src, size)
+        uint64_t dst = regs[0], size = regs[3];
+        dm_pmirror_sync();
+        pthread_mutex_lock(&g_pm_mu);
+        for (int i = 0; i < g_npm; i++) if (g_pm[i].rw == dst && g_pm[i].size == size) { free(g_pm[i].snap); g_pm[i] = g_pm[--g_npm]; break; }
+        pthread_mutex_unlock(&g_pm_mu);
+        pthread_mutex_lock(&g_map_lock);
+        int k = map_find(dst, size); if (k && g_map[k - 1].base == dst) map_del(k - 1);
+        pthread_mutex_unlock(&g_map_lock);
+        regs[0] = 0; return 0;
+    }
+#endif
     case 0x04: {  // MapMemory(dst, src, size): when creating a thread the SDK moves the stack on the heap into the stack region
         uint64_t dst = regs[0], src = regs[1], size = regs[2];
         uint32_t result = map_arguments(dst, src, size);
@@ -943,7 +1091,25 @@ uint64_t svc_dispatch(int num, uint64_t *regs, uint64_t orig_addr) {
             uint64_t top = (uint64_t)pthread_get_stackaddr_np(pthread_self()), ssz = pthread_get_stacksize_np(pthread_self());
             if (addr < top && addr >= top - ssz) { base = top - ssz; size = ssz; state = 0xB/*Stack*/; perm = 3; }
             // Other host memory: report "free, no permissions" (the 4 KiB page around it) as Horizon does for unmapped addresses. It used to report Code+RX, and GetExceptionInfo walking back from main merged on through host memory down to 0
-            else { base=addr & ~0xFFFull; size=0x1000; state=0/*Free*/; perm=0; } }
+            // Free host memory is reported as one region up to the next module or the guest address space above it (to the end of the address space when there is none:
+            // base + size wraps to 0), as Horizon reports a gap. exlaunch mods walk the whole address space region by region (addr = base + size until it wraps): UltraCam's
+            // startup walked host memory 4 KB at a time, about 36 million queries a second for minutes, and the game stayed on a grey screen
+            else {
+                uint64_t hi = 0, fr = fake_rtld_base();
+                for (int i = 0; i < g_nmod; i++) {
+                    if (!g_mod[i].base) continue;
+                    uint64_t b = (uint64_t)(uintptr_t)g_mod[i].base + (g_mod[i].patch_off < 0 ? (uint64_t)g_mod[i].patch_off : 0);
+                    if (b > addr && (!hi || b < hi)) hi = b;
+                }
+                if ((uint64_t)(uintptr_t)g_as > addr && (!hi || (uint64_t)(uintptr_t)g_as < hi)) hi = (uint64_t)(uintptr_t)g_as;
+                if (fr && addr >= fr && addr < fr + 0x3000) {   // the stand-in rtld (fake_rtld_base): text, rodata, data
+                    uint64_t k = (addr - fr) >> 12;
+                    base = fr + (k << 12); size = 0x1000; state = k == 2 ? 4/*CodeData*/ : 3/*Code*/; perm = k == 0 ? 5 : k == 1 ? 1 : 3;
+                } else {
+                    if (fr && fr > addr && (!hi || fr < hi)) hi = fr;
+                    base = addr & ~0xFFFull; size = hi - base; state = 0/*Free*/; perm = 0;
+                }
+            } }
         map_source_query(addr, &base, &size, &attr, &perm);
         pthread_mutex_unlock(&g_map_lock);
         if (mi) {
@@ -1024,7 +1190,10 @@ uint64_t svc_dispatch(int num, uint64_t *regs, uint64_t orig_addr) {
         if (regs[0] & 0x80000000ull) return 0;   // notification only, can continue
         _exit(42);
     }
-    case 0x1E: guest_clock_read_wait(); regs[0] = 0; regs[1] = guest_ticks(); return 0;   // GetSystemTick
+    // GetSystemTick: Horizon returns the tick in x0 (no result code; libnx and the SDK's svc stub are "svc 0x1e; ret" returning u64). It used to answer x0 = 0, x1 = tick:
+    // the SDK reads cntpct_el0 and never noticed, but exlaunch mods seed their RNG from svcGetSystemTick. UltraCam's virtmem random address finder (subsdk3+0x83250)
+    // drew the same candidate from seed 0 forever (0x7088e81000, inside the alias region) and TOTK stayed on a grey screen. x1 keeps the tick too
+    case 0x1E: { guest_clock_read_wait(); uint64_t t = guest_ticks(); regs[0] = t; regs[1] = t; return 0; }
     case 0x27: {  // OutputDebugString(str, len)
         if (g_flag.dbg) fprintf(stderr, "[guest] %.*s\n", (int)regs[1], (char *)regs[0]);
         regs[0] = 0; return 0;
diff --git a/dm/host/loader.c b/dm/host/loader.c
index da3a970..07e79f6 100644
--- a/dm/host/loader.c
+++ b/dm/host/loader.c
@@ -2,6 +2,7 @@
 // The code area (original text and patch area) is set to read-only+execute as soon as it is copied in, and from then on the loader only writes data: on iOS these two blocks must be embedded as is as signed code segments.
 #include "dm.h"
 #include <TargetConditionals.h>
+#include <libkern/OSCacheControl.h>
 #include <fcntl.h>
 #include <errno.h>
 #include <sys/mman.h>
@@ -265,6 +266,7 @@ static void read_layout(module_t *m, const char *dir) {
         else if (!strcmp(key, "RO_OFF")) m->ro_off = v;
         else if (!strcmp(key, "DATA_OFF")) m->data_off = v;
