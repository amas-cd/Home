From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Anas <assosbs9@gmail.com>
Date: Sun, 8 Nov 2026 01:16:41 +0000
Subject: [PATCH] ExeFS mods: exlaunch modules on the Mac host (TOTK Online,
 UltraCam)

Several added modules placed after main; QueryMemory reports Horizon's regions for host memory and a stand-in rtld; GetSystemTick in x0; MapProcessMemory writable aliases of code; the derived profile kept across builds with mods; programs dumped on the Mac (shader_dumps) join the shader split.

Upstream-Status: fork-only
Reason: exlaunch based mods (Tears of the Kingdom Online, UltraCam) on the Mac
Issue: LNPANDY/NX2Apple#214
---
 dm/gfx/tools/shader_split.py  |  11 ++
 dm/host/dm.h                  |   2 +
 dm/host/hle_fs.c              |   6 +
 dm/host/hle_svc.c             | 173 ++++++++++++++++++++++++-
 dm/host/loader.c              | 235 +++++++++++++++++++++++++++++++++-
 dm/tools/exefs_mod.py         | 216 +++++++++++++++++++++++++++++++
 dm/tools/patch_nso.py         |  27 ++--
 scripts/build_ipa_from_nsp.py |  47 ++++++-
 8 files changed, 703 insertions(+), 14 deletions(-)
 create mode 100644 dm/tools/exefs_mod.py
 mode change 100755 => 100644 scripts/build_ipa_from_nsp.py

diff --git a/dm/gfx/tools/shader_split.py b/dm/gfx/tools/shader_split.py
index 78e2fcd..842385e 100644
--- a/dm/gfx/tools/shader_split.py
+++ b/dm/gfx/tools/shader_split.py
@@ -3142,6 +3142,17 @@ def main():
         names = sorted(f for f in os.listdir(ued) if f.endswith('.ushaderbytecode') and not f.startswith('._')) if os.path.isdir(ued) else []   # AppleDouble metadata, not decoded shader archives
         if not names and uepak.unreal_paks(romfs, inline=False, mains=[mainnso]): red(f'the RomFS has Unreal paks, but there are no decoded shader code archives in {ued} (the NSP script writes them)')
         for nm in names: found += ue_shaders(open(os.path.join(ued, nm), 'rb').read(), f'/ue_shaders/{nm}')
+        # Programs dumped on the Mac (DM_NVN_SHDUMP: <key>.ctl + <key>.code) that no game file holds: <version dir>/shader_dumps, or DM_SHADER_DUMPS. Tears of the Kingdom Online's
+        # ImGui (the names over the players, their icons on the map, the chat) draws with a vertex and a pixel program that live in the mod's subsdk4, whose relocated records
+        # raw_shaders cannot follow. Each is checked as the other readers' programs are; none is paired (no prebuilt pipeline: built on first use)
+        sdd = os.environ.get('DM_SHADER_DUMPS') or os.path.join(os.path.dirname(os.path.abspath(romfs)), 'shader_dumps')
+        for nm in (sorted(f[:-4] for f in os.listdir(sdd) if f.endswith('.ctl')) if os.path.isdir(sdd) else []):
+            cp = os.path.join(sdd, nm + '.code')
+            if not os.path.isfile(cp): continue
+            ctl, code = open(os.path.join(sdd, nm + '.ctl'), 'rb').read(), open(cp, 'rb').read()
+            st = glslc_stage(ctl, code) if CTL_MAGIC not in code else None
+            if st and not check(f'/shader_dumps/{nm}', st, ctl, code): found.append((f'/shader_dumps/{nm}', st, ctl, code))
+            else: print(f'[RED] /shader_dumps/{nm}: not a program the readers take; left out', flush=True)
         results.append(('main', {skey(c, k): (w, s, c, k) for w, s, c, k in found}, var_pairs(found), {}))
     for romfs in dlc_v:
         name = os.path.basename(os.path.normpath(romfs))
