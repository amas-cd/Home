+def apply_exefs_mods(py, repo, exe_dir, out, mods, g, logs, env, unregistered, app):
+    """dm/tools/exefs_mod.py: the ExeFS with the mods applied into out; the modules they add go into the profile's module list (only a derived or provisional profile, which
+    lives outside the repository, is written). Returns (the modded ExeFS, the profile, {added module: its offset from main's base in the host})"""
+    for m in mods:
