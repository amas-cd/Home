From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Anas <assosbs9@gmail.com>
Date: Sun, 8 Nov 2026 01:16:41 +0000
Subject: [PATCH] Online play: network, account nickname (DM_NICK), software
 keyboard and companion server for the online mods

Upstream-Status: fork-only
Reason: Tears of the Kingdom Online and Super Mario Odyssey Online on the Mac
Issue: LNPANDY/NX2Apple#214
---
 dm/host/front.h       |   4 +-
 dm/host/front_mac.m   |  29 +++++++-
 dm/host/hle_account.c | 116 ++++++++++++++++++++++++-------
 dm/host/hle_net.c     | 157 ++++++++++++++++++++++++++++++++++++++----
 dm/host/hle_oe.c      |   5 ++
 dm/host/hle_offline.c |  37 ++++++----
 dm/host/hle_swkbd.c   |   8 ++-
 dm/mac/launcher.c     |  19 ++++-
 8 files changed, 314 insertions(+), 61 deletions(-)

diff --git a/dm/host/front.h b/dm/host/front.h
index d36e61c..6cdbbb9 100644
--- a/dm/host/front.h
+++ b/dm/host/front.h
@@ -3,8 +3,8 @@
 #include <stdlib.h>
 // Metal reads HUD switches when the first device is made. Called before host preload and again after the launcher applies its settings; explicit environment values win.
 static inline void front_hud_env(void) {
-    const char *e = getenv("DM_METAL_HUD");
-    if (!e || !atoi(e)) return;
+    // Metal's HUD is readied in every start; the game layer's developerHUDProperties mode then shows or hides it (front_mac.m: DM_METAL_HUD at the start,
+    // Cmd-Shift-F while playing). An MTL_HUD_ENABLED already in the environment wins
     setenv("MTL_HUD_ENABLED", "1", 0);
     // Spatial scaling has no temporal exposure: showing that HUD metric makes the MetalFX rows flicker.
     setenv("MTL_HUD_HIDE_METALFX_METRICS", "1", 0);
diff --git a/dm/host/front_mac.m b/dm/host/front_mac.m
index 92d90ad..c95aeed 100644
--- a/dm/host/front_mac.m
+++ b/dm/host/front_mac.m
@@ -656,6 +656,25 @@ - (void)windowDidFailToEnterFullScreen:(NSWindow *)w { (void)w; if (g_fs_failed)
 // Metal reads MTL_HUD_ENABLED when the process makes its first device, which can be before the window: set from DM_METAL_HUD before main (set in front_run, the HUD did not show)
 __attribute__((constructor)) static void hud_env(void) { front_hud_env(); }
 
+// ⌘⇧F (Window menu): shows or hides Apple's performance HUD (frame rate, frame and GPU time, memory) over the game while it runs. front_hud_env readies Metal's HUD
+// in every start, and the game layer's developerHUDProperties mode decides: default shows it, disabled hides it, as the iOS front end does (DM_METAL_HUD sets the start)
+static int g_hud_shown;
+static void hud_apply(void) {
+    if (!g_layer) return;
+    g_layer.developerHUDProperties = @{@"mode": g_hud_shown ? @"default" : @"disabled"};
+}
+@interface DmHudToggle : NSObject
+- (void)toggleHud:(id)sender;
+@end
+@implementation DmHudToggle
+- (void)toggleHud:(id)sender {
+    (void)sender;
+    g_hud_shown = !g_hud_shown; hud_apply();
+    LOG("front end: performance HUD %s (Cmd-Shift-F)", g_hud_shown ? "shown" : "hidden");
+}
+@end
+static DmHudToggle *g_hud_toggle;
+
 // ---------- Cheats: the menu and the panel (hle_cheats.c holds every state; these only show it and call it) ----------
 
 // A string of the engine as an NSString that is never nil: cheat names, sections and notes come from the player's files,
@@ -1522,9 +1541,10 @@ void front_run(void (*guest)(void)) {
         g_layer.device = MTLCreateSystemDefaultDevice();
         g_layer.pixelFormat = MTLPixelFormatBGRA8Unorm;
         g_layer.contentsScale = win.backingScaleFactor;
-        // Apple's HUD over the game (frame rate, frame and GPU time, memory): front_hud_env turns it on before the first device. The layer's developerHUDProperties
-        // stay unset: mode=default forces this layer's HUD on, so the Metal HUD menu's Hide HUD left it on screen
-        if (getenv("DM_METAL_HUD") && atoi(getenv("DM_METAL_HUD"))) LOG("front end: Metal performance HUD on (DM_METAL_HUD)");
+        // Apple's HUD over the game (frame rate, frame and GPU time, memory): front_hud_env readies it before the first device in every start, and this layer's
+        // developerHUDProperties mode shows it (default) or hides it (disabled): DM_METAL_HUD at the start, then Cmd-Shift-F in the Window menu (hud_apply)
+        g_hud_shown = getenv("DM_METAL_HUD") && atoi(getenv("DM_METAL_HUD")); hud_apply();
+        if (g_hud_shown) LOG("front end: Metal performance HUD on (DM_METAL_HUD)");
         v.layer = g_layer; [(DmGameView *)v fitDrawable];
         [win center];
         [win makeKeyAndOrderFront:nil];
@@ -1556,6 +1576,9 @@ void front_run(void (*guest)(void)) {
             dispatch_async(dispatch_get_main_queue(), ^{ [g_cheats_menu showPanel:nil]; });
         [[bar addItemWithTitle:@"Window" action:nil keyEquivalent:@""] setSubmenu:wm];
         [wm addItemWithTitle:@"Enter Full Screen" action:@selector(toggleFullScreen:) keyEquivalent:@"f"].keyEquivalentModifierMask = NSEventModifierFlagControl | NSEventModifierFlagCommand;
+        g_hud_toggle = [DmHudToggle new];
+        NSMenuItem *hudItem = [wm addItemWithTitle:@"Show / Hide FPS" action:@selector(toggleHud:) keyEquivalent:@"f"];
+        hudItem.keyEquivalentModifierMask = NSEventModifierFlagCommand | NSEventModifierFlagShift; hudItem.target = g_hud_toggle;
         NSApp.mainMenu = bar;
         const char *fs = getenv("DM_FULLSCREEN");   // 1 (or any value but 0): start in fullscreen; 0, the settings window's Window, or unset: a window
         if (fs && strcmp(fs, "0")) {
