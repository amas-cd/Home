+// ---------- DM_NET=1: the bsd socket service on the host's own sockets (ExeFS mods that talk to a server: Super Mario Odyssey: Online) ----------
+// Off by default: every game keeps its offline branch. On, the socket calls below go to the host's BSD sockets. Horizon's bsd service is FreeBSD's: sockaddr / sockaddr_in
+// (with sin_len), pollfd, AF_INET / SOCK_STREAM / IPPROTO_TCP, SOL_SOCKET 0xffff and its options, MSG_* flags, F_GETFL / F_SETFL / O_NONBLOCK and the errno values the
+// games test are the same numbers on macOS, so most arguments and results pass through as they are; O_NONBLOCK (0x800 on Horizon) and the errno numbering are translated. Descriptors are the
+// host's. nifm stays "network unavailable": the game's own online code (NEX) keeps its offline branch, and a mod that only waits for its network request goes on.
+// A call that can block releases the guest core while it waits (dm_thread_native_wait), as the host's other blocking waits do.
+static int g_net = -1, g_net_default;
+void dm_net_default(int on) { g_net_default = on; }   // loader.c: on when an ExeFS mod added a module (a mod that brings code is the one that talks to a server); DM_NET=0 turns it off
+int dm_net_on(void) {
+    if (g_net < 0) { const char *e = getenv("DM_NET"); g_net = e && *e ? atoi(e) > 0 : g_net_default; if (g_net) LOG("DM_NET: socket calls go to the host's sockets (nifm stays offline)%s", e && *e ? "" : "; on because an ExeFS mod added a module (DM_NET=0 turns it off)"); }
+    return g_net;
+}
+static __thread int t_neterr;
+// The errno a game reads (nn::socket::GetLastErrno) in the numbering emulators give it, Linux's (Ryujinx's LinuxError, yuzu's Errno): Super Mario Odyssey: Online's emulator build
+// checks 11 for "no data yet" after a non-blocking Recv (MSG_DONTWAIT, its sock_flags 0x80), and macOS's 35 made it take every partial header as a broken connection and reconnect.
+// The flags and structures stay as they are (FreeBSD's, the same numbers as macOS's)
+static int linux_errno(int e) {
+    switch (e) {
+    case EAGAIN: return 11; case EINPROGRESS: return 115; case EALREADY: return 114; case ENOTSOCK: return 88; case EDESTADDRREQ: return 89; case EMSGSIZE: return 90;
+    case EPROTOTYPE: return 91; case ENOPROTOOPT: return 92; case EPROTONOSUPPORT: return 93; case EOPNOTSUPP: return 95; case EAFNOSUPPORT: return 97;
+    case EADDRINUSE: return 98; case EADDRNOTAVAIL: return 99; case ENETDOWN: return 100; case ENETUNREACH: return 101; case ENETRESET: return 102;
+    case ECONNABORTED: return 103; case ECONNRESET: return 104; case ENOBUFS: return 105; case EISCONN: return 106; case ENOTCONN: return 107; case ESHUTDOWN: return 108;
+    case ETIMEDOUT: return 110; case ECONNREFUSED: return 111; case EHOSTDOWN: return 112; case EHOSTUNREACH: return 113;
+    default: return e;   // EPERM 1 … EPIPE 32: the same numbers
+    }
+}
+static int nerr(long r) { if (r < 0) t_neterr = linux_errno(errno); return (int)r; }
+static long nerrl(long r) { if (r < 0) t_neterr = linux_errno(errno); return r; }
+int dm_net_errno(void) { return t_neterr; }
+int dm_net_socket(int d, int t, int p) {
+    int s = socket(d, t, p);
+    if (s >= 0) { int one = 1; setsockopt(s, SOL_SOCKET, SO_NOSIGPIPE, &one, sizeof one); }   // a send to a closed peer returns EPIPE instead of killing the process (Horizon has no SIGPIPE)
+    LOG("DM_NET socket(%d, %d, %d) = %d", d, t, p, s);
+    return nerr(s);
+}
+// The server a mod connects to is often the one the launcher starts with the game (DM_COMPANION: Tears of the Kingdom Online's Java server takes about
+// 10 s to listen; the mod asks for the address and connects a few seconds after boot, and a refused connection left it on a grey screen). A connection to
+// this Mac (127.x) while a companion runs first waits, up to 60 s, until something listens on that port: lsof is asked, no connection is made to test it
+static void wait_local_server(const void *a, unsigned n) {
+    const uint8_t *b = a;
+    if (n < 8 || b[1] != 2 /*AF_INET*/ || b[4] != 127 || !getenv("DM_COMPANION")) return;
+    unsigned port = b[2] << 8 | b[3]; char cmd[128]; snprintf(cmd, sizeof cmd, "/usr/sbin/lsof -nP -iTCP:%u -sTCP:LISTEN -t 2>/dev/null", port);
+    for (int i = 0; i < 120; i++) {
+        FILE *f = popen(cmd, "r"); char line[32] = ""; if (f) { if (!fgets(line, sizeof line, f)) line[0] = 0; pclose(f); }
+        if (line[0]) { if (i) LOG("DM_NET the local server on port %u is listening (waited %.1f s)", port, i * 0.5); return; }
+        if (!i) LOG("DM_NET nothing listens on 127.0.0.1:%u yet: waiting for the server the launcher started (DM_COMPANION), up to 60 s", port);
+        usleep(500000);
+    }
+    LOG("[RED] DM_NET the local server on port %u never started listening (60 s): connecting anyway", port);
+}
+int dm_net_connect(int s, const void *a, unsigned n) {
+    dm_thread_native_wait(1); wait_local_server(a, n); int r = connect(s, a, n); int e = errno; dm_thread_native_wait(0); errno = e;
+    if (n >= 8) { const uint8_t *b = a; LOG("DM_NET connect(%d, %u.%u.%u.%u:%u) = %d%s", s, b[4], b[5], b[6], b[7], b[2] << 8 | b[3], r, r < 0 ? strerror(errno) : ""); }
+    return nerr(r);
+}
+int dm_net_bind(int s, const void *a, unsigned n) { return nerr(bind(s, a, n)); }
+int dm_net_listen(int s, int n) { return nerr(listen(s, n)); }
+int dm_net_accept(int s, void *a, unsigned *n) { dm_thread_native_wait(1); int r = accept(s, a, (socklen_t *)n); int e = errno; dm_thread_native_wait(0); errno = e; return nerr(r); }
+int dm_net_close(int s) { return nerr(close(s)); }
+int dm_net_shutdown(int s, int h) { return nerr(shutdown(s, h)); }
+static int net_trace(void) { static int v = -1; if (v < 0) { const char *e = getenv("DM_NET_LOG"); v = e && *e ? atoi(e) : 0; } return v; }   // DM_NET_LOG=1: each send / recv (first 200 of each kind)
+static void net_note(const char *op, int s, unsigned long n, int f, long r, int e) {
+    if (!net_trace()) return;
+    static _Atomic long last_r[2]; static _Atomic int rep[2]; int k = op[0] == 's';
+    if (r == atomic_load(&last_r[k])) { int c = atomic_fetch_add(&rep[k], 1) + 1; if (c == 1 || c % 500) return; LOG("DM_NET %s: %d more of %ld bytes", op, c, r); return; }
+    atomic_store(&last_r[k], r); atomic_store(&rep[k], 0);
+    static _Atomic int cnt[2]; if (atomic_fetch_add(&cnt[k], 1) >= 400) return;
+    if (r < 0 && (e == EAGAIN || e == EWOULDBLOCK)) { static _Atomic int again; if (atomic_fetch_add(&again, 1) >= 5) return; }
+    LOG("DM_NET %s(%d, %lu, flags %#x) = %ld%s%s", op, s, n, f, r, r < 0 ? " " : "", r < 0 ? strerror(e) : "");
+}
+// MSG_* flags: OOB 1, PEEK 2, DONTROUTE 4, WAITALL 0x40, DONTWAIT 0x80 are the same on Horizon and macOS; others (Horizon's MSG_NOSIGNAL 0x20000) are dropped (SO_NOSIGPIPE is set)
+#define NET_FLAGS(f) ((f) & 0xC7)
+long dm_net_recv(int s, void *b, unsigned long n, int f) { dm_thread_native_wait(1); long r = recv(s, b, n, NET_FLAGS(f)); int e = errno; dm_thread_native_wait(0); net_note("recv", s, n, f, r, e); errno = e; return nerrl(r); }
+long dm_net_recvfrom(int s, void *b, unsigned long n, int f, void *a, unsigned *al) { dm_thread_native_wait(1); long r = recvfrom(s, b, n, f, a, (socklen_t *)al); int e = errno; dm_thread_native_wait(0); errno = e; return nerrl(r); }
+long dm_net_send(int s, const void *b, unsigned long n, int f) { dm_thread_native_wait(1); long r = send(s, b, n, NET_FLAGS(f)); int e = errno; dm_thread_native_wait(0); net_note("send", s, n, f, r, e); errno = e; return nerrl(r); }
+long dm_net_sendto(int s, const void *b, unsigned long n, int f, const void *a, unsigned al) { dm_thread_native_wait(1); long r = sendto(s, b, n, f, a, al); int e = errno; dm_thread_native_wait(0); errno = e; return nerrl(r); }
+int dm_net_getsockname(int s, void *a, unsigned *n) { return nerr(getsockname(s, a, (socklen_t *)n)); }
+int dm_net_getpeername(int s, void *a, unsigned *n) { return nerr(getpeername(s, a, (socklen_t *)n)); }
+int dm_net_setsockopt(int s, int l, int o, const void *v, unsigned n) { return nerr(setsockopt(s, l, o, v, n)); }
+int dm_net_getsockopt(int s, int l, int o, void *v, unsigned *n) {
+    int r = getsockopt(s, l, o, v, (socklen_t *)n);
+    if (!r && l == 0xffff && o == 0x1007 && v && n && *n >= 4 && *(int *)v) *(int *)v = linux_errno(*(int *)v);   // SO_ERROR (a non-blocking connect's outcome): the errno numbering the game reads
+    return nerr(r);
+}
+// Fcntl: Horizon's O_NONBLOCK is 0x800 (nn::socket::FcntlFlag::O_NonBlock; Ryujinx tests the same bit), macOS's is 4 (0x800 there is O_EXCL, which F_SETFL ignores).
+// Passed through, Tears of the Kingdom Online's "make the socket non-blocking" left it blocking: its Recv waited for data inside the game's frame and the screen
+// stayed grey, and it never got to send. F_GETFL (3) and F_SETFL (4) are the same numbers; other commands pass through
+int dm_net_fcntl(int s, int c, int v) {
+    int r;
+    if (c == 4) {   // F_SETFL
+        int cur = fcntl(s, F_GETFL, 0); if (cur < 0) cur = 0;
+        r = fcntl(s, F_SETFL, (v & 0x800) ? (cur | O_NONBLOCK) : (cur & ~O_NONBLOCK));
+    } else if (c == 3) {   // F_GETFL
+        r = fcntl(s, F_GETFL, 0);
+        if (r >= 0) r = (r & O_NONBLOCK ? 0x800 : 0) | (r & O_ACCMODE);
+    } else r = fcntl(s, c, v);
+    if (net_trace()) LOG("DM_NET fcntl(%d, %d, %#x) = %#x", s, c, v, r);
+    return nerr(r);
+}
+void dm_guest_sleep_ns(int64_t ns);
+// A poll with no timeout that finds nothing waits 1 ms before it answers 0: Super Mario Odyssey: Online's emulator build polls in a loop with timeout 0 (its pollTime), which kept
+// a host core at 100% (50 s of CPU in 53 s) next to the game's own threads
+int dm_net_poll(void *f, uint64_t n, int ms) {
+    dm_thread_native_wait(1); int r = poll(f, (nfds_t)n, ms); int e = errno; dm_thread_native_wait(0); errno = e;
+    if (r == 0 && ms == 0) dm_guest_sleep_ns(1000000);
+    return nerr(r);
+}
+// The resolver: macOS's struct hostent has the guest's layout (char *, char **, int, int, char **), and the guest reads host memory directly, so the host's entry is returned
+// as it is (per thread, as the guest's own is static). Runs on the big host stack (HLE_FORCE_BIG at the hooks): the system resolver needs more than a game thread's stack
+void *dm_net_gethostbyname(const char *name) {
+    dm_thread_native_wait(1); struct hostent *h = gethostbyname(name); int e = h_errno; dm_thread_native_wait(0);
+    LOG("DM_NET gethostbyname(%s) = %s", name ? name : "(null)", h ? "found" : "not found");
+    if (!h) t_neterr = e;
+    return h;
+}
