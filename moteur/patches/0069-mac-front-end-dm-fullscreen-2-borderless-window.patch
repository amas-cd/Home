From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Anas <anas@local>
Date: Sun, 8 Nov 2026 21:01:34 +0000
Subject: [PATCH] mac front end: DM_FULLSCREEN=2, borderless window over the
 screen (no Space switch; a launcher stays behind, its HUD above)

Upstream-Status: fork-only
Reason: the Salon launcher keeps the game on its own screen (black desktop) with its HUD above: no fullscreen Space, no switch animation
Issue: Salon
---
 dm/host/front_mac.m | 21 +++++++++++++++++++--
 docs/settings.md    |  2 +-
 2 files changed, 20 insertions(+), 3 deletions(-)

diff --git a/dm/host/front_mac.m b/dm/host/front_mac.m
index 5db275e..547b99a 100644
--- a/dm/host/front_mac.m
+++ b/dm/host/front_mac.m
@@ -1561,6 +1561,23 @@ void front_run(void (*guest)(void)) {
                 LOG("front end: window on screen %lu '%s' (DM_SCREEN)", id, on.localizedName.UTF8String);
             } else LOG("front end: DM_SCREEN=%s ignored, no connected screen has that number", want_scr);
         }
+        // Salon: DM_FULLSCREEN=2, fullscreen without a Space. The window covers its screen as a plain window: a launcher stays behind it (its black
+        // desktop), the launcher's HUD can sit above it, and there is no Space switch animation. Menu bar and Dock are hidden while the game is
+        // the active app. ⌃⌘F still enters the classic macOS fullscreen if wanted.
+        const char *fs0 = getenv("DM_FULLSCREEN");
+        if (fs0 && !strcmp(fs0, "2")) {
+            win.styleMask = NSWindowStyleMaskTitled | NSWindowStyleMaskFullSizeContentView;   // titled (can be key), title bar invisible
+            win.titlebarAppearsTransparent = YES; win.titleVisibility = NSWindowTitleHidden; win.movable = NO;
+            for (NSUInteger b = NSWindowCloseButton; b <= NSWindowZoomButton; b++) [win standardWindowButton:(NSWindowButton)b].hidden = YES;
+            win.collectionBehavior = NSWindowCollectionBehaviorFullScreenPrimary | NSWindowCollectionBehaviorManaged;
+            NSApp.presentationOptions = NSApplicationPresentationHideMenuBar | NSApplicationPresentationHideDock;
+            [win setFrame:(win.screen ?: NSScreen.mainScreen).frame display:YES];
+            [NSNotificationCenter.defaultCenter addObserverForName:NSApplicationDidBecomeActiveNotification object:nil queue:nil usingBlock:^(NSNotification *n) { (void)n;
+                if (win.styleMask & NSWindowStyleMaskFullScreen) return;
+                NSApp.presentationOptions = NSApplicationPresentationHideMenuBar | NSApplicationPresentationHideDock;
+                [win setFrame:(win.screen ?: NSScreen.mainScreen).frame display:YES]; }];
+            LOG("front end: borderless fullscreen window (DM_FULLSCREEN=2) %dx%d on '%s'", (int)win.frame.size.width, (int)win.frame.size.height, (win.screen ?: NSScreen.mainScreen).localizedName.UTF8String);
+        }
         [win makeKeyAndOrderFront:nil];
         screen_refresh(win.screen ?: NSScreen.mainScreen);
         g_win = win;
@@ -1594,8 +1611,8 @@ void front_run(void (*guest)(void)) {
         NSMenuItem *hudItem = [wm addItemWithTitle:@"Show / Hide FPS" action:@selector(toggleHud:) keyEquivalent:@"f"];
         hudItem.keyEquivalentModifierMask = NSEventModifierFlagCommand | NSEventModifierFlagShift; hudItem.target = g_hud_toggle;
         NSApp.mainMenu = bar;
-        const char *fs = getenv("DM_FULLSCREEN");   // 1 (or any value but 0): start in fullscreen; 0, the settings window's Window, or unset: a window
-        if (fs && strcmp(fs, "0")) {
+        const char *fs = getenv("DM_FULLSCREEN");   // 1 (or any value but 0 and 2): start in fullscreen; 2: borderless window over the screen (above); 0, the settings window's Window, or unset: a window
+        if (fs && strcmp(fs, "0") && strcmp(fs, "2")) {
             // A game opened from a fullscreen app starts while macOS leaves that Space. Wait for activation and for the window to reach the active Space before asking for fullscreen
             // (whichever happens last), and repeat a refused startup request once. Only a request made here owns a retry; a later player request must never restart startup handling
             static DmWinDelegate *wd; wd = [DmWinDelegate new]; win.delegate = wd;
diff --git a/docs/settings.md b/docs/settings.md
index a826eee..d768402 100644
--- a/docs/settings.md
+++ b/docs/settings.md
@@ -267,7 +267,7 @@ A line like `DM_PRESENT_SNAP=0` in `Documents/env.txt` (in the Files app, under
 | Render scale | `DM_RENDER_SCALE` | `0.5` to `1.0` |
 | Console mode | `DM_OPMODE` | `1` docked, `0` handheld |
 | Game language | `DM_LANG` | a language code, such as `ja` |
-| Display mode (Mac) | `DM_FULLSCREEN` | `1` fullscreen, `0` a window |
+| Display mode (Mac) | `DM_FULLSCREEN` | `1` fullscreen, `2` a borderless window covering the screen (no Space, for a launcher behind it), `0` a window |
 | Cloud saves folder (Mac) | `DM_SAVE_SYNC` | a folder; `icloud`: iCloud Drive › nxnative Saves; `0`: off |
 | Picture (iPhone and iPad) | `DM_PICTURE_FIT` | `fit` 16:9 with black bars, `fill` covers the screen, cropped |
 | Picture shape | `DM_SCREEN_ASPECT` | `auto` the app window's own shape where it is taller than 16:9 (iPad 4:3, iPhone Duo 1.43:1), else 16:9 (iOS only); `1.43` the iPhone Duo's shape, `0` 16:9 |
