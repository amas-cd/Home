From 893647db739545741c94c30b2bc9dd918a9ac073 Mon Sep 17 00:00:00 2001
From: Anas <assosbs9@gmail.com>
Date: Tue, 10 Nov 2026 11:30:27 +0000
Subject: [PATCH 32/44] totk: with TOTK_FULLSCREEN=1 the resolution setting
 does not resize the window

The resolution restored at start sized the window while the full-screen
animation was still running, which took the window out of full screen.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01TFGN95PNfagSjomeenf2po
---
 games/totk/runtime/settings_panel.h | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/games/totk/runtime/settings_panel.h b/games/totk/runtime/settings_panel.h
index 4b1a2bfe..01496950 100644
--- a/games/totk/runtime/settings_panel.h
+++ b/games/totk/runtime/settings_panel.h
@@ -162,6 +162,9 @@ int nvn_fps_lock(void);
    (the aspect ratio picked) and shrunk to fit the screen's visible area. Full screen stays as it is. */
 static void settings_window_size(unsigned w,unsigned h,double ratio) {
  if(!window||(window.styleMask&NSWindowStyleMaskFullScreen))return;
+ /* A launcher asked for full screen (TOTK_FULLSCREEN=1): the window keeps the screen. The resolution restored at start came
+    while the full-screen animation was still running (the style mask not yet set) and its resize took the window out of it. */
+ {const char *fs=getenv("TOTK_FULLSCREEN");if(fs&&!strcmp(fs,"1"))return;}
  NSScreen *screen=window.screen?:NSScreen.mainScreen;if(!screen||!(ratio>0)||!w||!h)return;
  NSRect visible=screen.visibleFrame,content=[window contentRectForFrameRect:visible];
  CGFloat ch=round(fmin(h,fmin(content.size.height,content.size.width/ratio))),cw=round(ch*ratio);
