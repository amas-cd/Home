From 4a6c0d47efba49600f953dc689d1a1a035e1cc3c Mon Sep 17 00:00:00 2001
From: Anas <assosbs9@gmail.com>
Date: Wed, 11 Nov 2026 11:45:29 +0000
Subject: [PATCH 38/44] totk: TOTK_RT=0 (or DM_RT=0) leaves the present thread
 without the time-constraint declaration

The declared computation follows the thread's measured CPU time: once the clock dropped the frames took longer, the
declaration rose toward 15 ms and the performance controller kept the low clock (Tears of the Kingdom outdoors on a
MacBook Air M5: 1.4-2 GHz, 40-50 fps). nxnative carries the same switch (DM_RT=0), with which Ocarina of Time's market
went from 10-16 to 60 fps. Off by default; the main thread keeps its user-interactive QoS.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01TFGN95PNfagSjomeEnf2po
---
 games/totk/third_party/d2r_gfx/gfx/nvn/hle_nvn.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/games/totk/third_party/d2r_gfx/gfx/nvn/hle_nvn.c b/games/totk/third_party/d2r_gfx/gfx/nvn/hle_nvn.c
index bdf827de..85399783 100644
--- a/games/totk/third_party/d2r_gfx/gfx/nvn/hle_nvn.c
+++ b/games/totk/third_party/d2r_gfx/gfx/nvn/hle_nvn.c
@@ -3126,7 +3126,13 @@ static void slow_emit(uint64_t f) {
 // The computation used to be hard-coded at 2 ms, while the game main thread (game logic + recording + submit replay) takes about 10 ms per frame when hot - a 5× gap between declared and actual:
 // a real-time thread that exceeds its declared computation gets demoted by the system, and the performance controller also sets frequency from the declaration (this declaration is how the system learns the frame deadline and the workload).
 // DM_RT_COMP=<ms> fixes the declaration; default auto = every 120 frames take the p90 of this thread's per-frame CPU time and re-declare if it differs from the declared value by > 15% (capped at 0.9 × period).
+/* TOTK_RT=0 (or nxnative's DM_RT=0) leaves the present thread on the standard policy, its user-interactive QoS only (threads.c).
+   The declaration follows the thread's measured CPU time: once the clock dropped, the frames took longer, the declared
+   computation rose toward 15 ms and the performance controller kept the low clock (Tears of the Kingdom outdoors on a
+   MacBook Air M5: 1.4-2 GHz, 40-50 fps; Ocarina of Time's market on nxnative went from 10-16 to 60 fps with DM_RT=0). */
+static int rt_on(void) { static int v = -1; if (v < 0) { const char *e = getenv("TOTK_RT"); if (!e || !*e) e = getenv("DM_RT"); v = !(e && !strcmp(e, "0")); if (!v) LOG("[nvn] TOTK_RT=0: the present thread gets no time-constraint policy (QoS only)"); } return v; }
 static void set_time_constraint_comp(uint64_t period_ns, uint64_t comp_ns) {
+    if (!rt_on()) return;
     static mach_timebase_info_data_t tb; if (!tb.denom) mach_timebase_info(&tb);
     if (comp_ns < 1000000ull) comp_ns = 1000000ull; if (comp_ns > period_ns * 9 / 10) comp_ns = period_ns * 9 / 10;
     thread_time_constraint_policy_data_t p = {
