From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Anas <assosbs9@gmail.com>
Date: Sun, 8 Nov 2026 23:08:59 +0000
Subject: [PATCH 10/44] frontend: the borderless window stays on the launcher's
 display after [window center] and the first ordering

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01TFGN95PNfagSjomeEnf2po
---
 games/totk/runtime/frontend.m | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/games/totk/runtime/frontend.m b/games/totk/runtime/frontend.m
index 8636b0d76ee536643bf8f293fa9ae81e3bd36b2a..6191560d76d62f6f3266cbeeede342616d1f1ef3 100644
--- a/games/totk/runtime/frontend.m
+++ b/games/totk/runtime/frontend.m
@@ -20,6 +20,7 @@
 #include "../third_party/d2r_gfx/gfx/nvn/totk_mfx_mode.h"
 #include "../third_party/d2r_gfx/gfx/nvn/fps_overlay.h"
 static NSWindow *window;
+static NSScreen *borderlessScreen;   /* TOTK_BORDERLESS=1: the display the launcher asked for (TOTK_SCREEN_ID) */
 uint64_t dm_nvn_frame_count(void);   /* gfx/nvn/hle_nvn.c: game frames presented so far */
 static CAMetalLayer *metalLayer;
 static _Atomic float hdrHeadroom=1;
@@ -773,10 +774,10 @@ with it (a test's frames and pictures then say nothing). */
     NSScreen *sc=window.screen?:NSScreen.mainScreen;
     {const char *id=getenv("TOTK_SCREEN_ID");if(id&&*id){unsigned long want=strtoul(id,NULL,10);   /* the launcher's display (NSScreenNumber), else the window's */
       for(NSScreen *s in NSScreen.screens)if([s.deviceDescription[@"NSScreenNumber"] unsignedLongValue]==want){sc=s;break;}}}
-    [window setFrame:sc.frame display:YES];
+    borderlessScreen=sc;[window setFrame:sc.frame display:YES];
     fprintf(stderr,"[totk] borderless window on '%s' (%dx%d)\n",sc.localizedName.UTF8String,(int)sc.frame.size.width,(int)sc.frame.size.height);
     [NSNotificationCenter.defaultCenter addObserverForName:NSApplicationDidBecomeActiveNotification object:nil queue:nil usingBlock:^(NSNotification *n){(void)n;
-      if(window.styleMask&NSWindowStyleMaskFullScreen)return;NSApp.presentationOptions=NSApplicationPresentationHideMenuBar|NSApplicationPresentationHideDock;[window setFrame:(window.screen?:NSScreen.mainScreen).frame display:YES];}];
+      if(window.styleMask&NSWindowStyleMaskFullScreen)return;NSApp.presentationOptions=NSApplicationPresentationHideMenuBar|NSApplicationPresentationHideDock;[window setFrame:(borderlessScreen?:window.screen?:NSScreen.mainScreen).frame display:YES];}];
   }}
   if(window.level!=NSFloatingWindowLevel)window.collectionBehavior|=NSWindowCollectionBehaviorFullScreenPrimary;   /* a floating test window is an auxiliary one */
   window.tabbingMode=NSWindowTabbingModeDisallowed;
@@ -820,6 +821,7 @@ corners by the present encoder (gfx/nvn/fps_overlay.c). The box sits under the o
   if(window.level==NSFloatingWindowLevel){NSRect f=window.frame;[window setFrameOrigin:NSMakePoint(NSMaxX(vis)-f.size.width,NSMaxY(vis)-f.size.height)];}   /* TOTK_WINDOW_FLOAT: top-right corner */
   front_sync_drawable();
   if(assume_focus()){[window orderFrontRegardless];}else{[window makeKeyAndOrderFront:nil];[NSApp activateIgnoringOtherApps:YES];}   /* in front of other apps' windows, keyboard left alone */
+  if(borderlessScreen){[window setFrame:borderlessScreen.frame display:YES];dispatch_async(dispatch_get_main_queue(),^{[window setFrame:borderlessScreen.frame display:YES];});}   /* TOTK_BORDERLESS: [window center] above and the first ordering go to the key window's screen; the chosen screen wins */
   totk_board_start();   /* the leaderboard's rounds (board_upload.h): nothing is sent unless the player turned 我要上榜 on */
 #ifdef GAME_INBOX_ID   /* game_version.h names Breath of the Wild, Bananza and Pokopia; Tears of the Kingdom otherwise */
   mng_active_start(@GAME_INBOX_ID, mng_active_version());
