diff --git a/games/totk/runtime/online_host.c b/games/totk/runtime/online_host.c
new file mode 100644
index 0000000000000000000000000000000000000000..ef81134f3edf366c985de9e185eaf9fc86c425b8
--- /dev/null
+++ b/games/totk/runtime/online_host.c
@@ -0,0 +1,84 @@
+/* Host side of nn::socket for a mod module that plays online (TOTK Online: a client socket to its server; scripts/mod_module.py
+   loads the module). The retail game imports none of these, so nothing changes for it; the mod's imports bind to these functions
+   (runtime_override, before the SDK's own code, whose bsd:u service the host has no implementation of).
+
+   Horizon's socket library is FreeBSD's: sockaddr_in (sin_len, sin_family = 2, sin_port, sin_addr), the MSG_* flags, F_GETFL /
+   F_SETFL with O_NONBLOCK = 4, SOL_SOCKET = 0xffff and the errno numbers are the same values as macOS's, so descriptors and
+   arguments pass straight through. The host's descriptors are returned as the guest's. GetLastErrno is per thread, like the SDK's. */
+#include "runtime.h"
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <arpa/inet.h>
+#include <netinet/in.h>
+#include <netinet/tcp.h>
+#include <sys/socket.h>
+#include <poll.h>
+
+static _Thread_local int online_errno;
+static int online_log(void) { static int v = -1; if (v < 0) { const char *e = getenv("TOTK_ONLINE_LOG"); v = e && *e && strcmp(e, "0"); } return v; }
+static int fail(const char *what) { online_errno = errno ? errno : EIO; if (online_log()) fprintf(stderr, "[totk-online] %s: %s (%d)\n", what, strerror(online_errno), online_errno); return -1; }
+
+static uint32_t online_initialize(void *pool, uint64_t pool_size, uint64_t alloc_pool_size, int concurrency) {
+    (void)pool; (void)pool_size; (void)alloc_pool_size; (void)concurrency;
+    fprintf(stderr, "[totk-online] nn::socket::Initialize: host BSD sockets\n"); return 0;
+}
+static int online_last_errno(void) { return online_errno; }
+static int online_socket(int domain, int type, int protocol) {
+    int fd = socket(domain, type, protocol);
+    if (fd < 0) return fail("socket");
+    int one = 1; setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, &one, sizeof one);   /* a closed peer must not kill the game */
+    if (type == SOCK_STREAM) setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, &one, sizeof one);
+    if (online_log()) fprintf(stderr, "[totk-online] socket(%d,%d,%d) = %d\n", domain, type, protocol, fd);
+    return fd;
+}
+static int online_connect(int fd, const struct sockaddr *addr, uint32_t len) {
+    if (online_log() && addr && addr->sa_family == AF_INET) { char ip[64]; const struct sockaddr_in *in = (const struct sockaddr_in *)addr;
+        fprintf(stderr, "[totk-online] connect(%d) -> %s:%u\n", fd, inet_ntop(AF_INET, &in->sin_addr, ip, sizeof ip), ntohs(in->sin_port)); }
+    int r = connect(fd, addr, len);
+    return r < 0 ? fail("connect") : r;
+}
+static int64_t online_send(int fd, const void *buf, uint64_t len, int flags) { ssize_t r = send(fd, buf, (size_t)len, flags | MSG_NOSIGNAL); return r < 0 ? fail("send") : r; }
+static int64_t online_recv(int fd, void *buf, uint64_t len, int flags) { ssize_t r = recv(fd, buf, (size_t)len, flags); return r < 0 ? fail("recv") : r; }
+static int online_close(int fd) { if (online_log()) fprintf(stderr, "[totk-online] close(%d)\n", fd); int r = close(fd); return r < 0 ? fail("close") : r; }
+/* The guest follows AAPCS64 (its third argument in x2) while Apple's arm64 ABI passes variadic arguments on the stack:
+   a fixed third parameter reads x2, which is where the module put it. */
+static int online_fcntl(int fd, int cmd, long arg) {
+    int r = fcntl(fd, cmd, arg);
+    return r < 0 ? fail("fcntl") : r;
+}
+static int online_getsockopt(int fd, int level, int name, void *val, uint32_t *len) { socklen_t l = len ? *len : 0; int r = getsockopt(fd, level, name, val, &l); if (len) *len = l; return r < 0 ? fail("getsockopt") : r; }
+static int online_setsockopt(int fd, int level, int name, const void *val, uint32_t len) { int r = setsockopt(fd, level, name, val, len); return r < 0 ? fail("setsockopt") : r; }
+static int online_getpeername(int fd, struct sockaddr *addr, uint32_t *len) { socklen_t l = len ? *len : 0; int r = getpeername(fd, addr, &l); if (len) *len = l; return r < 0 ? fail("getpeername") : r; }
+static int online_getsockname(int fd, struct sockaddr *addr, uint32_t *len) { socklen_t l = len ? *len : 0; int r = getsockname(fd, addr, &l); if (len) *len = l; return r < 0 ? fail("getsockname") : r; }
+static int online_shutdown(int fd, int how) { int r = shutdown(fd, how); return r < 0 ? fail("shutdown") : r; }
+static int online_poll(void *fds, uint64_t n, int timeout) { int r = poll(fds, (nfds_t)n, timeout); return r < 0 ? fail("poll") : r; }
+static int online_inet_pton(int af, const char *src, void *dst) { return inet_pton(af, src, dst); }
+static int online_inet_aton(const char *cp, struct in_addr *addr) { return inet_aton(cp, addr); }
+static uint16_t online_htons(uint16_t v) { return htons(v); }
+static uint32_t online_htonl(uint32_t v) { return htonl(v); }
+static uint16_t online_ntohs(uint16_t v) { return ntohs(v); }
+static uint32_t online_ntohl(uint32_t v) { return ntohl(v); }
+static const char *online_ntop(int af, const void *src, char *dst, uint32_t size) { return inet_ntop(af, src, dst, size); }
+
+void *runtime_online_override(const char *name) {
+    static const struct { const char *name; void *fn; } map[] = {
+        {"_ZN2nn6socket10InitializeEPvmmi", online_initialize},
+        {"_ZN2nn6socket12GetLastErrnoEv", online_last_errno}, {"_ZN2nn6socket12GetLastErrorEv", online_last_errno},
+        {"_ZN2nn6socket6SocketEiii", online_socket}, {"_ZN2nn6socket7ConnectEiPK8sockaddrj", online_connect},
+        {"_ZN2nn6socket4SendEiPKvmi", online_send}, {"_ZN2nn6socket4RecvEiPvmi", online_recv},
+        {"_ZN2nn6socket5CloseEi", online_close}, {"_ZN2nn6socket5FcntlEiiz", online_fcntl},
+        {"_ZN2nn6socket10GetSockOptEiiiPvPj", online_getsockopt}, {"_ZN2nn6socket10SetSockOptEiiiPKvj", online_setsockopt},
+        {"_ZN2nn6socket11GetPeerNameEiP8sockaddrPj", online_getpeername}, {"_ZN2nn6socket11GetSockNameEiP8sockaddrPj", online_getsockname},
