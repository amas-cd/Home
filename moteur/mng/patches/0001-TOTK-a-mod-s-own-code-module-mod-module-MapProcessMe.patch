diff --git a/games/totk/scripts/mod_module.py b/games/totk/scripts/mod_module.py
new file mode 100644
index 0000000000000000000000000000000000000000..de5d0cdc2dd5358af8e6a6c4efcdaf38aa7608f7
--- /dev/null
+++ b/games/totk/scripts/mod_module.py
@@ -0,0 +1,97 @@
+#!/usr/bin/env python3
+"""Add a mod's own code module (an extra NSO, `subsdk4` of TOTK Online for instance) to the build as the game's next
+`subsdkN`, so the loader runs its code beside main, subsdk0 and sdk.
+
+The loader takes its module list from the runtime tables (runtime/loader.c, up to 12 modules named main, subsdk0…,
+sdk) and scripts/prepare_runtime.py puts every rewritten/<version>/subsdkN.patched.bin in them: what this script does
+is bring the mod's module to that state, exactly like the retail modules —
+
+  1. the NSO is copied to extracted/<version>/exefs/<name> (prepare_runtime reads its header for the symbol count);
+  2. scripts/prepare_modules.py inventories it (segments verified, dynamic symbols) into extracted/<version>/elf/;
+  3. third_party/d2r/patch_nso.py rewrites it for Apple silicon into rewritten/<version>/<name>.patched.bin.
+
+build_app.py then records the rewritten image's SHA-256 in the validation report, which binds the loader to it.
+The mod's code hooks the game at run time (exlaunch-style, through MapProcessMemory on the code pages), so no patch of
+main is merged here; a mod that also ships main patches goes through --mod (mod_exefs.py) as before.
+
+usage: mod_module.py --tree <work tree> --version v121 --module <NSO> [--name subsdk1] [--report <json>]
+"""
+import argparse
+import hashlib
+import json
+import os
+import shutil
+import struct
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+
+def sha256(path):
+    h = hashlib.sha256()
+    with open(path, 'rb') as f:
+        for block in iter(lambda: f.read(1 << 20), b''):
+            h.update(block)
+    return h.hexdigest()
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument('--tree', type=Path, required=True)
+    ap.add_argument('--version', required=True)
+    ap.add_argument('--module', type=Path, required=True, help="the mod's NSO (subsdk4 of TOTK Online, say)")
+    ap.add_argument('--name', default=None, help='the module name in the build: the next free subsdkN (default)')
+    ap.add_argument('--report', type=Path)
+    a = ap.parse_args()
+    tree, version = a.tree.resolve(), a.version
+    exefs = tree / f'extracted/{version}/exefs'
+    elf = tree / f'extracted/{version}/elf'
+    out = tree / f'rewritten/{version}'
+    py = tree / '.venv/bin/python'
+    if not (exefs / 'main').is_file() or not (elf / 'main-inventory.json').is_file():
+        sys.exit('the retail code must be extracted and inventoried first (build_app.py step 1/4)')
+    data = a.module.read_bytes()
+    if data[:4] != b'NSO0':
+        sys.exit(f'{a.module} is not an NSO module')
+    name = a.name
+    if not name:
+        shipped = {n for n in os.listdir(exefs) if n.startswith('subsdk')}
+        name = next(f'subsdk{i}' for i in range(10) if f'subsdk{i}' not in shipped)
+    staged = exefs / name
+    if not staged.is_file() or sha256(staged) != hashlib.sha256(data).hexdigest():
+        staged.write_bytes(data)
+    # inventory: prepare_modules.py on a folder holding only this module, then only its files are copied in
+    with tempfile.TemporaryDirectory(dir=tree / 'extracted') as tmp:
+        tmp = Path(tmp)
+        (tmp / 'exefs').mkdir(); shutil.copy2(staged, tmp / 'exefs' / name)
+        (tmp / 'elf').mkdir()
+        subprocess.run([py, 'scripts/prepare_modules.py', tmp / 'exefs', '--output', tmp / 'elf'], cwd=tree, check=True,
+                       stdout=subprocess.DEVNULL)
+        for f in (tmp / 'elf').iterdir():
+            if f.name.startswith(name + '-') or f.name.startswith(name + '.'):
+                shutil.copy2(f, elf / f.name)
+    inventory = json.loads((elf / f'{name}-inventory.json').read_text())
+    # rewrite, cached on the module's bytes and the rewriter
+    out.mkdir(parents=True, exist_ok=True)
+    image = out / f'{name}.patched.bin'
+    stamp = out / f'{name}.mod-module.json'
+    key = dict(module_sha256=hashlib.sha256(data).hexdigest(), rewriter_sha256=sha256(tree / 'third_party/d2r/patch_nso.py'))
+    previous = json.loads(stamp.read_text()) if stamp.is_file() else {}
+    if not (image.is_file() and previous.get('module_sha256') == key['module_sha256'] and previous.get('rewriter_sha256') == key['rewriter_sha256']):
+        env = dict(os.environ, DM_RULESET='native', DM_PRIVATE_GATES='0')
+        subprocess.run([py, 'third_party/d2r/patch_nso.py', staged, out, name], cwd=tree, check=True, env=env,
+                       stdout=subprocess.DEVNULL)
+    key['rewritten_sha256'] = sha256(image)
+    stamp.write_text(json.dumps(key, indent=2) + '\n')
+    text = struct.unpack_from('<III', data, 0x10)
+    result = dict(status='pass', name=name, source=str(a.module), module_sha256=key['module_sha256'],
+                  rewritten_sha256=key['rewritten_sha256'], text_size=text[2],
+                  symbols=inventory.get('dynsym_count', inventory.get('symbols', None)) if isinstance(inventory, dict) else None)
+    if a.report:
+        a.report.write_text(json.dumps(result, indent=2) + '\n')
+    print(json.dumps(result, indent=2))
+
+
+if __name__ == '__main__':
+    main()
