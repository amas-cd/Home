+static uint32_t mod_profile_image(size_t *size, void *buffer, size_t cap, const void *uid) {
+    (void)uid; size_t n = sizeof k_profile_jpeg;
+    if (size) *size = n;
+    if (buffer && cap) memcpy(buffer, k_profile_jpeg, n < cap ? n : cap);
+    if (online_log()) fprintf(stderr, "[totk-online] profile image: %zu-byte JPEG (buffer %zu)\n", n, cap);
+    return 0;
+}
