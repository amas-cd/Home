Date: Sun, 8 Nov 2026 22:59:09 +0000
Subject: [PATCH 08/44] =?UTF-8?q?runtime:=20what=20a=20mod=20module=20impo?=
 =?UTF-8?q?rts=20beyond=20sockets=20=E2=80=94=20MountSdCard,=20touch=20scr?=
 =?UTF-8?q?een=20and=20single=20mouse=20state,=20LoadProfileImage?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The SDK's own nn::hid::InitializeTouchScreen opened the hid IPC service (not implemented) from the mod's DT_INIT.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01TFGN95PNfagSjomeEnf2po
---
 games/totk/runtime/fs_host.c     | 6 ++++--
 games/totk/runtime/online_host.c | 9 +++++++++
 2 files changed, 13 insertions(+), 2 deletions(-)

diff --git a/games/totk/runtime/fs_host.c b/games/totk/runtime/fs_host.c
index 4a5f966f..235a6677 100644
--- a/games/totk/runtime/fs_host.c
+++ b/games/totk/runtime/fs_host.c
@@ -34,7 +34,7 @@
 #else
 #define TOTK_APPLICATION_ID 0x0100f2c0115b6000ULL
 #endif
-enum { M_FREE, M_SAVE, M_TEMP, M_CACHE };
+enum { M_FREE, M_SAVE, M_TEMP, M_CACHE, M_SD };
 enum { OPEN_READ = 1, OPEN_WRITE = 2, OPEN_APPEND = 4 };
 #define FILE_BASE 0x200000000ULL
 #define DIR_BASE 0x300000000ULL
@@ -193,6 +193,8 @@ static void set_fs_context(const FsContext *context) { thread_context = context;
 static unsigned char own_save_exists(const uint64_t *uid) { return save_exists(TOTK_APPLICATION_ID, uid); }
 static unsigned ensure_save(const uint64_t *uid) { return own_save_exists(uid) ? 0 : R_TARGET_NOT_FOUND; }
 static unsigned mount_temp(const char *name) { ready(); char p[1100]; snprintf(p, sizeof p, "%s/temp", profile); return mount_add(name, M_TEMP, p); }
+/* nn::fs::MountSdCard (a mod module's settings and logs, "sd:/..."): the profile's sdcard folder, kept between runs. */
+static unsigned mount_sdcard(const char *name) { ready(); char p[1100]; snprintf(p, sizeof p, "%s/sdcard", profile); mkdir(p, 0700); return mount_add(name, M_SD, p); }
 static void cache_dir(int index, char *out, size_t cap) { snprintf(out, cap, "%s/cache/%d", profile, index); }
 static unsigned create_cache(int index, int64_t size, int64_t journal) {
     ready(); if (index < 0 || size < 0 || journal < 0) return R_INVALID_ARGUMENT;
@@ -414,7 +416,7 @@ void *runtime_fs_host_override(const char *name) {
         {"_ZN2nn2fs12SetAllocatorEPFPvmEPFvS1_mE", fs_allocator},
         {"_ZN2nn2fs25GetCurrentThreadFsContextEv", get_fs_context}, {"_ZN2nn2fs25SetCurrentThreadFsContextEPKNS0_9FsContextE", set_fs_context},
         {"_ZN2nn2fs18IsSaveDataExistingERKNS_7account3UidE", own_save_exists}, {"_ZN2nn2fs14EnsureSaveDataERKNS_7account3UidE", ensure_save},
-        {"_ZN2nn2fs21MountTemporaryStorageEPKc", mount_temp}, {"_ZN2nn2fs7UnmountEPKc", unmount}, {"_ZN2nn2fs6CommitEPKc", commit},
+        {"_ZN2nn2fs21MountTemporaryStorageEPKc", mount_temp}, {"_ZN2nn2fs11MountSdCardEPKc", mount_sdcard}, {"_ZN2nn2fs7UnmountEPKc", unmount}, {"_ZN2nn2fs6CommitEPKc", commit},
 #ifdef GAME_BOTW
         {"_ZN2nn2fs14CommitSaveDataEPKc", commit},   /* SDK 7 (Breath of the Wild 1.6.0) */
 #endif
diff --git a/games/totk/runtime/online_host.c b/games/totk/runtime/online_host.c
index ef81134f..277e4621 100644
--- a/games/totk/runtime/online_host.c
+++ b/games/totk/runtime/online_host.c
@@ -7,6 +7,7 @@
    arguments pass straight through. The host's descriptors are returned as the guest's. GetLastErrno is per thread, like the SDK's. */
 #include "runtime.h"
 #include <errno.h>
+#include <stdatomic.h>
 #include <fcntl.h>
 #include <stdio.h>
 #include <stdlib.h>
@@ -64,8 +65,16 @@ static uint16_t online_ntohs(uint16_t v) { return ntohs(v); }
 static uint32_t online_ntohl(uint32_t v) { return ntohl(v); }
 static const char *online_ntop(int af, const void *src, char *dst, uint32_t size) { return inet_ntop(af, src, dst, size); }
 
+/* The rest of what an exlaunch-style mod imports from the SDK and the host does not otherwise replace: hid touch screen
+   and single mouse state (the SDK's own would open the "hid" IPC service and the hid shared memory), the profile image. */
+static void mod_touch_init(void) {}
+static void mod_touch_state16(uint8_t *out) { static _Atomic int64_t sample; memset(out, 0, 0x10 + 16 * 0x28); int64_t n = ++sample; memcpy(out, &n, 8); }   /* TouchScreenState<16>: no touches */
+static void mod_mouse_state(uint8_t *out) { static _Atomic int64_t sample; memset(out, 0, 0x28); int64_t n = ++sample; memcpy(out, &n, 8); }             /* MouseState: no mouse */
+static uint32_t mod_profile_image(size_t *size, void *buffer, size_t cap, const void *uid) { (void)buffer; (void)cap; (void)uid; if (size) *size = 0; return 0; }   /* nn::account::LoadProfileImage: no picture */
 void *runtime_online_override(const char *name) {
     static const struct { const char *name; void *fn; } map[] = {
+        {"_ZN2nn3hid21InitializeTouchScreenEv", mod_touch_init}, {"_ZN2nn3hid19GetTouchScreenStateILm16EEEvPNS0_16TouchScreenStateIXT_EEE", mod_touch_state16},
+        {"_ZN2nn3hid13GetMouseStateEPNS0_10MouseStateE", mod_mouse_state}, {"_ZN2nn7account16LoadProfileImageEPmPvmRKNS0_3UidE", mod_profile_image},
         {"_ZN2nn6socket10InitializeEPvmmi", online_initialize},
         {"_ZN2nn6socket12GetLastErrnoEv", online_last_errno}, {"_ZN2nn6socket12GetLastErrorEv", online_last_errno},
         {"_ZN2nn6socket6SocketEiii", online_socket}, {"_ZN2nn6socket7ConnectEiPK8sockaddrj", online_connect},
