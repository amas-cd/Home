From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Anas <assosbs9@gmail.com>
Date: Mon, 9 Nov 2026 13:17:29 +0000
Subject: [PATCH 29/44] build_app: --mod-module more than once, each mod module
 its own subsdkN

The loader's table holds main, subsdk0..subsdk9 and sdk: every module given takes the next number after the
retail subsdks, and mod_module.py --keep leaves the others of the same build in place.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01TFGN95PNfagSjomeEnf2po
---
 build_app.py                     | 36 ++++++++++++++++++++------------
 games/totk/scripts/mod_module.py |  4 +++-
 2 files changed, 26 insertions(+), 14 deletions(-)

diff --git a/build_app.py b/build_app.py
index c1b7feb50b96e8881aa6ad5a689b8a80d9e4a07c..71ea244e46ad3c99259f0e339a782b17e873f147 100644
--- a/build_app.py
+++ b/build_app.py
@@ -884,16 +884,26 @@ def step_code(tree, game, keys, env, logs, *, version="v0", mod=None, mod_module
     # --mod merged a patch into main, which the report records.
     digests = {f'{name}.patched.bin': sha256(out / f'{name}.patched.bin') for name in ('main', 'sdk', 'subsdk0')}
     extra = {}
-    if mod_module:
+    mod_modules = [mod_module] if isinstance(mod_module, Path) else list(mod_module or [])
+    if mod_modules:
         # A mod's own code module (scripts/mod_module.py): inventoried and rewritten like the retail ones, loaded next to
         # them (the loader takes the module list from the tables; prepare_runtime.py lists every subsdkN rewritten).
-        say(f'1/4 code: adding the mod module {mod_module.name} as a code module of the app')
-        mm_report = tree / f'extracted/{version}/mod-module.json'
-        run([py, 'scripts/mod_module.py', '--tree', tree, '--version', version, '--module', mod_module, '--report', mm_report],
-            logs / f'mod-module-{version}.log', cwd=tree)
-        mm = json.loads(mm_report.read_text())
-        extra = {f'extracted/{version}/exefs/{mm["name"]}': mm['module_sha256'], f'rewritten/{version}/{mm["name"]}.patched.bin': mm['rewritten_sha256']}
-        say(f'   {mm["name"]}: {mm["text_size"] // 1024} KiB of code, rewritten {mm["rewritten_sha256"][:16]}...')
+        # Several modules (--mod-module more than once) take the subsdk numbers after the retail ones, in order; the
+        # loader's table holds main, subsdk0..subsdk9 and sdk.
+        retail = [m['module'] for m in json.loads((tree / f'extracted/{version}/elf/modules.json').read_text())]
+        first = len([n for n in retail if n.startswith('subsdk')])
+        if first + len(mod_modules) > 10:
+            raise BuildError(f'{len(mod_modules)} mod modules: the app loads at most {10 - first} beside the game\'s own')
+        names = [f'subsdk{first + i}' for i in range(len(mod_modules))]
+        for i, (module, name) in enumerate(zip(mod_modules, names)):
+            say(f'1/4 code: adding the mod module {module.name} as a code module of the app ({name})')
+            mm_report = tree / (f'extracted/{version}/mod-module.json' if i == 0 else f'extracted/{version}/mod-module-{name}.json')
+            run([py, 'scripts/mod_module.py', '--tree', tree, '--version', version, '--module', module, '--name', name,
+                 *[x for other in names if other != name for x in ('--keep', other)], '--report', mm_report],
+                logs / f'mod-module-{version}-{name}.log', cwd=tree)
+            mm = json.loads(mm_report.read_text())
+            extra.update({f'extracted/{version}/exefs/{mm["name"]}': mm['module_sha256'], f'rewritten/{version}/{mm["name"]}.patched.bin': mm['rewritten_sha256']})
+            say(f'   {mm["name"]}: {mm["text_size"] // 1024} KiB of code, rewritten {mm["rewritten_sha256"][:16]}...')
     scope = f'hash match with verified {expected["display_version"]} rewrite'
     if merged:
         scope = (f'verified {expected["display_version"]} rewrite, with the main-module patches of {merged["folder"]} '
@@ -901,7 +911,7 @@ def step_code(tree, game, keys, env, logs, *, version="v0", mod=None, mod_module
     report = dict(format=1, status='pass', rom_version=version, scope=scope,
                   module_file_sha256={**{f'extracted/{version}/exefs/{n}': want[n] for n in ('main', 'sdk', 'subsdk0')},
                                       **{f'rewritten/{version}/{n}': digests[n] for n in digests}, **extra},
-                  **({'mod_module': str(mod_module)} if mod_module else {}),
+                  **({'mod_module': str(mod_modules[0]) if len(mod_modules) == 1 else [str(m) for m in mod_modules]} if mod_modules else {}),
                   **({'mod_exefs': {key: merged[key] for key in
                                     ('folder', 'folder_sha256', 'build_id', 'patches', 'edit_bytes', 'reserved_sites',
                                      'retail_main_sha256', 'patched_main_sha256', 'rewritten_main_sha256',
@@ -3429,7 +3439,7 @@ def parse_args(argv):
                     help='a mod folder prepared before the build: its exefs/ IPS / IPS32 / pchtxt patches for the main '
                          'module are merged into the code before it is rewritten (its romfs/ goes in with '
                          '--install-mod-romfs; docs/mods.md)')
-    ap.add_argument('--mod-module', type=Path, metavar='NSO',
+    ap.add_argument('--mod-module', type=Path, metavar='NSO', action='append',
                     help="a mod's own code module (TOTK Online's subsdk4, say): rewritten for Apple silicon and loaded "
                          'beside the game\'s modules, so its run-time hooks and its code run (scripts/mod_module.py)')
     ap.add_argument('--install-mod-romfs', action='store_true',
@@ -3503,7 +3513,7 @@ def main_from_work(args):
         raise BuildError(f'--mod expects a mod folder prepared before the build (its files under exefs/ and/or romfs/): {mod} has neither. See docs/mods.md.')
     if args.install_mod_romfs and not (mod and (mod / 'romfs').is_dir()): raise BuildError('--install-mod-romfs needs --mod with a romfs/ folder')
     code_mod = mod if mod and (mod / 'exefs').is_dir() else None
-    mod_module = args.mod_module.expanduser().resolve() if getattr(args, 'mod_module', None) else None
+    mod_module = [m.expanduser().resolve() for m in (args.mod_module or [])]
     args.mac_game_data, game_data_folder = mac_game_data(args, False)
     py = prerequisites(args)
     logs = work / 'logs'
@@ -3514,7 +3524,7 @@ def main_from_work(args):
     native_4k = True if native_5k else args.native_4k
     if native_4k is None: native_4k = version in ('v143', 'v121') and native_4k_default()
     say(f'Tears of the Kingdom {VERSIONS[version]["display_version"]} from the work folder {work}, without the game file'
-        + (f'; code mod {code_mod.name}' if code_mod else '') + (f'; mod module {mod_module.name}' if mod_module else ''))
+        + (f'; code mod {code_mod.name}' if code_mod else '') + (f'; mod modules {", ".join(m.name for m in mod_module)}' if mod_module else ''))
     step_code(tree, None, None, env, logs, version=version, mod=code_mod, mod_module=mod_module)
     if version == 'v0': step_data(tree, None, None, logs, mod=mod)
     else: step_update_data(tree, None, None, None, logs, version=version, mod=mod, native_4k=native_4k, native_5k=native_5k, vr=False)
@@ -3753,7 +3763,7 @@ def main(argv):
             ('' if not native_5k or native_5k_roomy() else
             '. Note: this Mac has less than 32 GB of memory; a native 5K app reserves about 2.7 GiB more than a 4K one at'
             ' every start, whatever is shown'))
-    mod_module = args.mod_module.expanduser().resolve() if getattr(args, 'mod_module', None) else None
+    mod_module = [m.expanduser().resolve() for m in (args.mod_module or [])]
     step_code(tree, game, keys, env, logs, mod=None if update else code_mod, mod_module=None if update else mod_module)
     if update:
         step_code(tree, update, keys, env, logs, version=version,
diff --git a/games/totk/scripts/mod_module.py b/games/totk/scripts/mod_module.py
index 974bd21fcbd4f4bd10315104308697d3f6cfa3dc..633f3a525d6a9ecbd3d791302067f77077bc60df 100644
--- a/games/totk/scripts/mod_module.py
+++ b/games/totk/scripts/mod_module.py
@@ -43,6 +43,8 @@ def main():
     ap.add_argument('--module', type=Path, required=True, help="the mod's NSO (subsdk4 of TOTK Online, say)")
     ap.add_argument('--name', default=None, help='the module name in the build: the next free subsdkN (default)')
     ap.add_argument('--report', type=Path)
+    ap.add_argument('--keep', action='append', default=[], metavar='subsdkN',
+                    help='another mod module of the same build (build_app.py --mod-module, given more than once): not removed as a stale copy')
     a = ap.parse_args()
     tree, version = a.tree.resolve(), a.version
     exefs = tree / f'extracted/{version}/exefs'
@@ -61,7 +63,7 @@ def main():
     name = a.name or f'subsdk{len(retail_subsdks)}'
     for k in range(10):
         other = f'subsdk{k}'
-        if other == name or other in retail_subsdks: continue
+        if other == name or other in retail_subsdks or other in a.keep: continue
         for stale in [exefs / other, *out.glob(f'{other}.*'), *elf.glob(f'{other}-*'), *elf.glob(f'{other}.*')]:
             if stale.exists(): stale.unlink()
     staged = exefs / name
