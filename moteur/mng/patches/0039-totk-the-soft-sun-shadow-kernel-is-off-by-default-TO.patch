From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Anas <assosbs9@gmail.com>
Date: Wed, 11 Nov 2026 11:47:10 +0000
Subject: [PATCH 39/44] totk: the soft sun-shadow kernel is off by default
 (TOTK_SHADOW_SOFT=<texels> turns it on)

It did not remove the steps of the low-resolution shadow mask, and its wider taps reach past the surface they shade:
Link's face fell into his own shadow and turned black.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01TFGN95PNfagSjomeEnf2po
---
 games/totk/third_party/d2r_gfx/gfx/nvn/totk_ssao.h | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/games/totk/third_party/d2r_gfx/gfx/nvn/totk_ssao.h b/games/totk/third_party/d2r_gfx/gfx/nvn/totk_ssao.h
index 7025e96173b6f31f9539ebaec6d8b427669796df..0a25660af6ade9cc59d2073251f2a2013a29bacd 100644
--- a/games/totk/third_party/d2r_gfx/gfx/nvn/totk_ssao.h
+++ b/games/totk/third_party/d2r_gfx/gfx/nvn/totk_ssao.h
@@ -287,11 +287,12 @@ static int ssao_entry(const char *key) {
    bilinear sample_compare taps of fp_t_tcb_14 (a 2x2 kernel); each tap becomes four taps half a texel-radius around it, so
    the kernel is a 4x4 grid of bilinear compares: a smoother and slightly wider penumbra. The mask this pass writes is
    upsampled to the screen, so a smoother term also softens its steps there. TOTK_SHADOW_SOFT=<texels> sets the radius
-   (default 1, 0.25 .. 3), TOTK_SHADOW_SOFT=0 keeps the game's own filter. The source is rebuilt at load with the AO patch
+   (0.25 .. 3; off by default since 11 Nov: a wider kernel reaches past the surface it shades, and Link's face fell into
+   his own shadow, black; it did not take the steps away either), unset or 0 keeps the game's own filter. The source is rebuilt at load with the AO patch
    (same keys and life cycle); a failed compile leaves both stock with a red line. */
 static float pcf_radius(void) {
     static float r; static dispatch_once_t once;
-    dispatch_once(&once, ^{ const char *e = getenv("TOTK_SHADOW_SOFT"); r = e && *e ? (float)atof(e) : 1.0f;
+    dispatch_once(&once, ^{ const char *e = getenv("TOTK_SHADOW_SOFT"); r = e && *e ? (float)atof(e) : 0.0f;
         if (r != 0 && (r < 0.25f || r > 3.0f)) r = 1.0f;
         MLOG("[pcf] sun shadows: %s", r > 0 ? [NSString stringWithFormat:@"4x4 compare kernel, radius %.2f texel (TOTK_SHADOW_SOFT)", r].UTF8String : "the game's own 2x2 filter (TOTK_SHADOW_SOFT=0)"); });
     return r;
